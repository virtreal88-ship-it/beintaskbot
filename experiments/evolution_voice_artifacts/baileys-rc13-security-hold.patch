@@ -0,0 +1,113 @@
+// Exercises the installed Baileys implementation to the sendNode boundary.
+// All identities, crypto, media cache and transport below are synthetic.
+// Run: node compat-tests/baileys-send-offline.mjs
+// Requires Node.js 22.15+ (module.registerHooks); verified with Node.js 24.
+import assert from 'node:assert/strict';
+import { EventEmitter } from 'node:events';
+import { registerHooks, syncBuiltinESMExports } from 'node:module';
+import {pathToFileURL} from 'node:url';
+import {resolve} from 'node:path';
+import net from 'node:net';
+import tls from 'node:tls';
+import http from 'node:http';
+import https from 'node:https';
+
+let networkAttempts = 0;
+let queryAttempts = 0;
+const unexpectedStacks=[];
+const denyNetwork = () => { networkAttempts++; throw new Error('Unexpected network access'); };
+globalThis.fetch = denyNetwork;
+globalThis.WebSocket = class { constructor() { denyNetwork(); } };
+net.connect = net.createConnection = denyNetwork;
+net.Socket.prototype.connect = denyNetwork;
+tls.connect = denyNetwork;
+http.request = http.get = denyNetwork;
+https.request = https.get = denyNetwork;
+syncBuiltinESMExports();
+
+const root = pathToFileURL(resolve('node_modules/baileys')+'/').href;
+const socketRoot = root + 'lib/Socket/';
+registerHooks({
+  load(url, context, nextLoad) {
+    // Avoid constructing a real WebSocket. messages-send.js itself remains real.
+    if (url === socketRoot + 'newsletter.js') {
+      return { format: 'module', source: 'export const makeNewsletterSocket = () => globalThis.__offlineBaileysSocket', shortCircuit: true };
+    }
+    return nextLoad(url, context);
+  },
+});
+
+const user = '994500000000:1@s.whatsapp.net';
+const recipient = process.env.VOICE_POC_DEST_JID || '994500000001@s.whatsapp.net';
+assert.match(recipient,/^[0-9]{5,22}@(s\.whatsapp\.net|lid)$/);
+const stanzas = [];
+const encrypted = [];
+const logger = {};
+for (const name of ['trace', 'debug', 'info', 'warn', 'error', 'fatal']) logger[name] = () => {};
+logger.child = () => logger;
+const unexpectedQuery = () => { queryAttempts++; const error=new Error('Unexpected query or USync');unexpectedStacks.push(error.stack);throw error; };
+globalThis.__offlineBaileysSocket = {
+  user: { id: user }, ev: new EventEmitter(),
+  authState: { creds: { me: { id: user } }, keys: { transaction: async (fn) => fn(), get: async (kind,ids) =>
+    kind==='tctoken' && process.env.VOICE_POC_EMPTY_KEYS!=='1' ? Object.fromEntries(ids.map(id=>[id,{senderTimestamp:Math.floor(Date.now()/1000)}])) : {}, set: async () => {} } },
+  processingMutex: { mutex: async (fn) => fn() },
+  signalRepository: {
+    lidMapping: {getLIDForPN: async () => undefined, getPNForLID: async () => undefined,
+      getLIDsForPNs: async () => [], storeLIDPNMappings: unexpectedQuery},
+    jidToSignalProtocolAddress: (jid) => jid,
+    validateSession: async () => ({ exists: true }),
+    encryptMessage: async (input) => { encrypted.push(input); return { type: 'msg', ciphertext: Buffer.from([1]) }; },
+  },
+  upsertMessage: async () => {}, query: unexpectedQuery, executeUSyncQuery: unexpectedQuery, registerSocketEndHandler:()=>{}, serverProps:{},
+  sendNode: async (stanza) => { stanzas.push(stanza); }, fetchPrivacySettings: async () => ({}),
+  groupMetadata: unexpectedQuery, groupToggleEphemeral: unexpectedQuery,
+};
+
+const { proto } = await import(root + 'WAProto/index.js');
+const encodedAudio = proto.Message.encode(proto.Message.fromObject({
+  audioMessage: { mimetype: 'audio/ogg; codecs=opus', ptt: true, seconds: 1, directPath: '/synthetic' },
+})).finish();
+const mediaCache = {
+  // A cache hit prevents media processing, file creation, upload and network.
+  get: async (key) => { assert.equal(key, 'audio:https://offline.invalid/synthetic'); return encodedAudio; },
+  set: async () => { throw new Error('Unexpected media cache miss'); },
+};
+const { makeMessagesSocket } = await import(socketRoot + 'messages-send.js');
+const { generateMessageIDV2 } = await import(root + 'lib/Utils/generics.js');
+const { getDevice } = await import(root + 'lib/Utils/messages.js');
+const version = JSON.parse(await (await import('node:fs/promises')).readFile(new URL(root + 'package.json'), 'utf8')).version;
+assert.equal(version, '7.0.0-rc13');
+const providerId = process.env.VOICE_POC_RESERVED_ID || generateMessageIDV2(user);
+const audio=Buffer.from(process.env.VOICE_POC_AUDIO_BASE64||Buffer.from('synthetic').toString('base64'),'base64');
+assert.ok(audio.length>0&&audio.length<=5*1024*1024);
+assert.match(providerId,/^3EB0[A-F0-9]{18}$/);
+const socket = makeMessagesSocket({
+  logger, mediaCache, options: {}, emitOwnEvents: false, patchMessageBeforeSending: async (message) => message,
+  userDevicesCache: { mget: async (users) => Object.fromEntries(users.map((value) => [value, [{ user: value, server: 's.whatsapp.net', device: 0 }]])) },
+});
+
+const message = await socket.sendMessage(recipient, {
+    audio: { url: 'https://offline.invalid/synthetic' }, ptt: true, mimetype: 'audio/ogg; codecs=opus', seconds: 1,
+  }, { messageId: providerId });
+assert.equal(message.key.id, providerId);
+assert.equal(message.key.remoteJid, recipient);
+assert.equal(message.key.fromMe, true);
+assert.equal(message.message.audioMessage.ptt, true);
+assert.equal(message.message.audioMessage.mimetype, 'audio/ogg; codecs=opus');
+assert.equal(stanzas.length, 1);
+assert.equal(stanzas[0].attrs.id, providerId);
+assert.equal(stanzas[0].attrs.to, recipient);
+const participants = stanzas[0].content.find((node) => node.tag === 'participants');
+assert.ok(participants?.content?.length);
+assert.equal(participants.content[0].content[0].attrs.mediatype, 'ptt');
+assert.ok(encrypted.length > 0);
+assert.equal(networkAttempts, 0);
+assert.equal(queryAttempts, process.env.VOICE_POC_EMPTY_KEYS==='1'?1:0, unexpectedStacks.join('\n'));
+
+// getDevice predicts a label from the ID string; it is not author proof.
+assert.equal(getDevice(providerId), 'web');
+assert.equal(getDevice('3A' + 'A'.repeat(18)), 'ios');
+assert.equal(getDevice('A'.repeat(21)), 'android');
+assert.equal(getDevice('OTHER'), 'unknown');
+if(process.env.VOICE_POC_JSON==='true')process.stdout.write(JSON.stringify({providerId,jid:recipient,socketUser:user,fromMe:true,ptt:true,source:getDevice(providerId),networkAttempts,queryAttempts})+'\n');
+else process.stdout.write('PASS Baileys 7.0.0-rc13 offline: supplied ID, exact JID and PTT reach intercepted sendNode; privacy IQ attempts: '+queryAttempts+' (blocked); source is only an ID-pattern prediction.\n');
diff --git a/compat-tests/crypto-offline.mjs b/compat-tests/crypto-offline.mjs
new file mode 100644
index 0000000..d02ab77
--- /dev/null
+++ b/compat-tests/crypto-offline.mjs
@@ -0,0 +1,29 @@
+// Synthetic cross-version primitives only; no account state or sockets.
+import assert from 'node:assert/strict';
+import {pathToFileURL} from 'node:url';
+import {resolve} from 'node:path';
+import {createHash,hkdfSync} from 'node:crypto';
+
+const base=process.env.VOICE_POC_BASELINE || '/workspace/voice-poc-deps/node_modules/baileys';
+const old=await import(pathToFileURL(resolve(base,'lib/Utils/crypto.js')).href);
+const next=await import(pathToFileURL(resolve('node_modules/baileys/lib/Utils/crypto.js')).href);
+const material=Buffer.from('synthetic-only-voice-fixture');
+for(const opts of [{info:'WhatsApp Audio Keys'}, {info:'',salt:Buffer.from('synthetic-salt')}]){
+  const prev=await old.hkdf(material,64,opts),cur=await next.hkdf(material,64,opts);
+  const expected=hkdfSync('sha256',material,opts.salt||Buffer.alloc(0),Buffer.from(opts.info),64);
+  assert.deepEqual(Buffer.from(cur),Buffer.from(prev));
+  assert.deepEqual(Buffer.from(cur),Buffer.from(expected));
+}
+assert.deepEqual(Buffer.from(next.md5(material)),createHash('md5').update(material).digest());
+const a=old.Curve.generateKeyPair(),b=next.Curve.generateKeyPair();
+assert.deepEqual(old.Curve.sharedKey(a.private,b.public),next.Curve.sharedKey(b.private,a.public));
+const previousSignature=old.Curve.sign(a.private,material),nextSignature=next.Curve.sign(b.private,material);
+assert.equal(next.Curve.verify(a.public,material,previousSignature),true);
+assert.equal(old.Curve.verify(b.public,material,nextSignature),true);
+assert.equal(next.Curve.verify(a.public,Buffer.from('different'),previousSignature),false);
+assert.equal(next.Curve.verify(b.public,Buffer.from('different'),nextSignature),false);
+assert.equal(next.Curve.verify(b.public,material,previousSignature),false);
+assert.equal(next.Curve.verify(a.public,material,Buffer.from('short')),false);
+const tampered=Buffer.from(previousSignature);tampered[0]^=1;
+assert.equal(next.Curve.verify(a.public,material,tampered),false);
+console.log('PASS synthetic rc9 ↔ rc13 HKDF, md5, ECDH and signatures');
diff --git a/compat-tests/patch-guard.test.cjs b/compat-tests/patch-guard.test.cjs
