index 0000000..6e981a0
--- /dev/null
+++ b/scripts/patch-baileys-curve.cjs
@@ -0,0 +1,40 @@
+// Local candidate only. Refuse unexpected package bytes or library versions.
+// These pinned wrappers ignore the boolean returned by libsignal.
+// This patch makes a false verification result fail closed.
+const fs = require('node:fs');
+const path = require('node:path');
+const {createHash} = require('node:crypto');
+const {createRequire} = require('node:module');
+const root = path.resolve(__dirname, '..', 'node_modules');
+const applicationRequire=createRequire(path.join(root,'..','dist/main.js'));
+const baileysPackage=applicationRequire.resolve('baileys/package.json');
+const baileys = JSON.parse(fs.readFileSync(baileysPackage, 'utf8'));
+// Resolve from Baileys itself, so a nested dependency cannot bypass the check.
+const baileysRequire=createRequire(baileysPackage);
+const signal = JSON.parse(fs.readFileSync(baileysRequire.resolve('libsignal/package.json'), 'utf8'));
+const versions={
+  '7.0.0-rc.9':{signal:'2.0.1',original:'51f8e1a7cead5e420b76713ee2f7d3d47592bf149d4d01826e0910196ec78d89',patched:'7a9def109ce4a6cefa811dccb458d3c258850bf3588182af4cf75b6f99e8dde0'},
+  '7.0.0-rc13':{signal:'6.0.0',original:'4d12873691b0a50e7db75b7e69df37f0f2f0ebf0e93f62fa7cbda9ff1ecc99d9',patched:'2cc0b9ccf5cb0dba06fa272072f7a1b654aadef726b1c771b8b096e54022d5d0'}
+};
+const selected=versions[baileys.version];
+if (!selected || signal.version !== selected.signal) throw Error('unsupported_crypto_dependencies');
+const file = path.join(path.dirname(baileysPackage), 'lib/Utils/crypto.js');
+const {original,patched}=selected;
+const source = fs.readFileSync(file, 'utf8');
+const hash = value => createHash('sha256').update(value).digest('hex');
+const signalCurve=baileysRequire.resolve('libsignal/src/curve.js');
+const signalSession=baileysRequire.resolve('libsignal/src/session_builder.js');
+if(hash(fs.readFileSync(signalCurve))!=='a45c682103f1ab047a24497db2175dec5605495d8c0f4c11354b347d31950f6a'||
+   hash(fs.readFileSync(signalSession))!=='e5bad7e4bf4a7164b7d2a8a37e3ab07988936b7bfc2fcdad684ac358b7981afb')throw Error('unexpected_signal_source');
+if (process.argv[2] === '--check') {
+  if(baileys.version!=='7.0.0-rc13')throw Error('release_requires_rc13');
+  if (hash(source) !== patched) throw Error('baileys_curve_patch_missing_or_changed');
+  process.exit(0);
+}
+if (process.argv[2] !== '--apply' || hash(source) !== original) throw Error('unexpected_baileys_curve_source');
+const before = '            curve.verifySignature(generateSignalPubKey(pubKey), message, signature);\n            return true;';
+const after = '            return curve.verifySignature(generateSignalPubKey(pubKey), message, signature) === true;';
+if (source.split(before).length !== 2) throw Error('ambiguous_baileys_curve_source');
+const result = source.replace(before, after);
+if (hash(result) !== patched) throw Error('invalid_baileys_curve_patch');
+fs.writeFileSync(file, result);
