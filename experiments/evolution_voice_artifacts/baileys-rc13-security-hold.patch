diff --git a/compat-tests/rc9-image-offline.mjs b/compat-tests/rc9-image-offline.mjs
new file mode 100644
index 0000000..8d23103
--- /dev/null
+++ b/compat-tests/rc9-image-offline.mjs
@@ -0,0 +1,38 @@
+// Run only in an isolated container of the exact pinned public rc9 image,
+// with /tmp as ephemeral tmpfs and this repository mounted read-only at /tests.
+// No production data, authentication or network.
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import {spawnSync} from 'node:child_process';
+import {pathToFileURL} from 'node:url';
+
+const root=fs.mkdtempSync('/tmp/rc9-curve-');
+try{
+  fs.mkdirSync(root+'/node_modules/baileys/lib/Utils',{recursive:true});
+  fs.mkdirSync(root+'/scripts',{recursive:true});
+  fs.copyFileSync('/tests/scripts/patch-baileys-curve.cjs',root+'/scripts/patch-baileys-curve.cjs');
+  fs.copyFileSync('/evolution/node_modules/baileys/package.json',root+'/node_modules/baileys/package.json');
+  fs.copyFileSync('/evolution/node_modules/baileys/lib/Utils/crypto.js',root+'/node_modules/baileys/lib/Utils/crypto.js');
+  fs.symlinkSync('/evolution/node_modules/libsignal',root+'/node_modules/libsignal');
+  fs.symlinkSync('/evolution/node_modules/baileys/lib/Defaults',root+'/node_modules/baileys/lib/Defaults');
+  const filename=root+'/node_modules/baileys/lib/Utils/crypto.js';
+  const pre=(await import(pathToFileURL(filename).href+'?before')).Curve;
+  const first=pre.generateKeyPair(),second=pre.generateKeyPair(),message=Buffer.from('synthetic'),changed=Buffer.from('different');
+  const signature=pre.sign(first.private,message);
+  assert.equal(pre.verify(first.public,message,signature),true);
+  // Reproduce the bug, without supplying network traffic or real credentials.
+  assert.equal(pre.verify(first.public,changed,signature),true);
+  const apply=spawnSync(process.execPath,[root+'/scripts/patch-baileys-curve.cjs','--apply'],{env:{PATH:process.env.PATH},encoding:'utf8'});
+  assert.equal(apply.status,0,apply.stderr);
+  const releaseCheck=spawnSync(process.execPath,[root+'/scripts/patch-baileys-curve.cjs','--check'],{env:{PATH:process.env.PATH},encoding:'utf8'});
+  assert.notEqual(releaseCheck.status,0,'rc9 must never pass the candidate release check');
+  const after=(await import(pathToFileURL(filename).href+'?after')).Curve;
+  assert.equal(after.verify(first.public,message,signature),true);
+  assert.equal(after.verify(first.public,changed,signature),false);
+  assert.equal(after.verify(second.public,message,signature),false);
+  assert.equal(after.verify(first.public,message,Buffer.from('short')),false);
+  const tampered=Buffer.from(signature);tampered[0]^=1;
+  assert.equal(after.verify(first.public,message,tampered),false);
+  assert.deepEqual(pre.sharedKey(first.private,second.public),after.sharedKey(second.private,first.public));
+  console.log('PASS pinned rc9 image copy: invalid message, signature and wrong key are rejected after local patch');
+}finally{fs.rmSync(root,{recursive:true,force:true});}
