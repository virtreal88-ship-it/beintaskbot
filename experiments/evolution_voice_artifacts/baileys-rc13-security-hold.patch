index 0000000..9659f84
--- /dev/null
+++ b/compat-tests/patch-guard.test.cjs
@@ -0,0 +1,63 @@
+// Synthetic disposable tree, tests patch admission and integrity guards.
+const {test} = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const {spawnSync} = require('node:child_process');
+
+test('candidate patch refuses missing patch, wrong versions and changed bytes', () => {
+  for(const script of ['Docker/scripts/deploy_database.sh','Docker/scripts/generate_database.sh']){
+    assert.doesNotMatch(fs.readFileSync(script,'utf8'),/echo\s+["']?[^\n]*\$\{?DATABASE_URL/);
+  }
+  const dir=fs.mkdtempSync(path.join(os.tmpdir(),'baileys-guard-'));
+  try {
+    fs.mkdirSync(path.join(dir,'scripts'),{recursive:true});
+    fs.mkdirSync(path.join(dir,'node_modules/baileys/lib/Utils'),{recursive:true});
+    fs.mkdirSync(path.join(dir,'node_modules/libsignal'),{recursive:true});
+    fs.mkdirSync(path.join(dir,'node_modules/libsignal/src'),{recursive:true});
+    for(const f of ['curve.js','session_builder.js'])fs.copyFileSync(path.join('node_modules/libsignal/src',f),path.join(dir,'node_modules/libsignal/src',f));
+    fs.copyFileSync('scripts/patch-baileys-curve.cjs',path.join(dir,'scripts/patch-baileys-curve.cjs'));
+    const lib=path.join(dir,'node_modules/baileys/lib/Utils/crypto.js');
+    const current=fs.readFileSync('node_modules/baileys/lib/Utils/crypto.js','utf8');
+    const after='            return curve.verifySignature(generateSignalPubKey(pubKey), message, signature) === true;';
+    const before='            curve.verifySignature(generateSignalPubKey(pubKey), message, signature);\n            return true;';
+    assert.equal(current.split(after).length,2);
+    const original=current.replace(after,before);
+    fs.writeFileSync(lib,original);
+    const b=path.join(dir,'node_modules/baileys/package.json'),s=path.join(dir,'node_modules/libsignal/package.json');
+    fs.writeFileSync(b,JSON.stringify({version:'7.0.0-rc13'}));fs.writeFileSync(s,JSON.stringify({version:'6.0.0'}));
+    const run=mode=>spawnSync(process.execPath,[path.join(dir,'scripts/patch-baileys-curve.cjs'),mode],{env:{PATH:process.env.PATH},encoding:'utf8'});
+    assert.notEqual(run('--check').status,0);
+    fs.writeFileSync(b,JSON.stringify({version:'7.0.0-rc14'}));assert.notEqual(run('--apply').status,0);
