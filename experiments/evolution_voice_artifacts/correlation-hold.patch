+  await assert.rejects(api.audioWhatsapp({}, undefined, false, correlation), /voice_correlation_unavailable/);
+  await assert.rejects(api.sendMessageWithTyping('synthetic', {}, undefined, false, correlation), /voice_correlation_unavailable/);
+  assert.equal(reads, 0); assert.equal(calls.length, 0);
+});
+test('actual closed guard does not change legacy calls without correlation', async () => {
+  const { make } = require('../poc/evolution-test-bridge.cjs');
