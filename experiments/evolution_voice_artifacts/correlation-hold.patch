+const path = require('node:path');
+const vm = require('node:vm');
+const { createRequire } = require('node:module');
+const ts = require('/workspace/voice-beintaskbot-connect/node_modules/typescript');
+
+const source = fs.readFileSync(path.join(__dirname, '../src/api/integrations/channel/whatsapp/voice-correlation-runtime.ts'), 'utf8');
+const compiled = ts.transpileModule(source, { compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2020 } }).outputText;
+const candidate = '/workspace/voice-security-poc/rc13';
+const vulnerable = '/workspace/voice-poc-deps';
+
+function loadAt(installation, enabled) {
+  const localRequire = createRequire(path.join(installation, 'synthetic-runtime.cjs'));
+  const exports = {};
+  const env = enabled === undefined ? {} : { VOICE_CORRELATION_POC_ENABLED: enabled };
+  vm.runInNewContext(compiled, { exports, require: localRequire, process: { env } });
+  return exports.assertVoiceCorrelationRuntime;
+}
+
+test('all versions, absent packages, and old opt-in settings remain unconditionally refused', () => {
+  assert.equal(JSON.parse(fs.readFileSync(path.join(vulnerable, 'node_modules/baileys/package.json'))).version, '7.0.0-rc.9');
+  assert.equal(JSON.parse(fs.readFileSync(path.join(candidate, 'node_modules/baileys/package.json'))).version, '7.0.0-rc13');
+  for (const installation of [candidate, vulnerable, '/nonexistent/voice-installation']) {
+    for (const enabled of ['true', 'false', undefined]) {
+      assert.throws(loadAt(installation, enabled), /voice_correlation_unavailable/);
+    }
+  }
+});
+test('the actual guard does not inspect environment or load dependencies', () => {
+  const exports = {};
+  const forbid = () => { throw Error('unexpected environment or dependency access'); };
+  vm.runInNewContext(compiled, { exports, require: forbid, process: new Proxy({}, { get: forbid }) });
+  assert.throws(exports.assertVoiceCorrelationRuntime, /voice_correlation_unavailable/);
+});
+test('both extracted Evolution entry points refuse before route lookup, conversion and provider', async () => {
+  const { make } = require('../poc/evolution-test-bridge.cjs');
+  const jid = '994500000000@s.whatsapp.net';
+  const correlation = { messageId: '3EB0ABCDEF123456789ABC', expectedJid: jid };
+  for (const installation of [vulnerable, candidate]) {
+    const {api, calls} = make(undefined, loadAt(installation, 'true'));
+    let touched = 0;
+    api.whatsappNumber = async () => { touched++; throw Error('route must not run'); };
+    api.processAudio = async () => { touched++; throw Error('conversion must not run'); };
+    await assert.rejects(api.audioWhatsapp({ number: jid, audio: 'synthetic-base64', encoding: true }, undefined, false, correlation), /voice_correlation_unavailable/);
+    await assert.rejects(api.sendMessageWithTyping(jid, { audio: Buffer.from('synthetic') }, undefined, false, correlation), /voice_correlation_unavailable/);
+    assert.equal(touched, 0); assert.equal(calls.length, 0);
+  }
+});
+test('closed guard refuses before evaluating correlation getters', async () => {
+  const { make } = require('../poc/evolution-test-bridge.cjs');
+  const { api, calls } = make(undefined, loadAt(candidate, 'true'));
+  let reads = 0;
