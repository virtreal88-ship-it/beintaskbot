@@ -0,0 +1,81 @@
+// Offline regression check of the self-only protocol guard in two pinned
+// Baileys packages. No embedded messages, real IDs, credentials or sockets.
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { readFile } from 'node:fs/promises';
+import net from 'node:net';
+import tls from 'node:tls';
+import http from 'node:http';
+import https from 'node:https';
+import { syncBuiltinESMExports } from 'node:module';
+
+let networkAttempts=0;
+const denyNetwork=()=>{networkAttempts++;throw Error('Network access forbidden');};
+globalThis.fetch=denyNetwork;
+globalThis.WebSocket=class { constructor(){denyNetwork();} };
+net.connect=net.createConnection=net.Socket.prototype.connect=denyNetwork;
+tls.connect=http.request=http.get=https.request=https.get=denyNetwork;
+syncBuiltinESMExports();
+
+const roots=[['rc9','7.0.0-rc.9'],['rc13','7.0.0-rc13']];
+const results={};
+for(const [label,expectedVersion] of roots){
+  const root=new URL(`./${label}/node_modules/baileys/`,import.meta.url);
+  const pkg=JSON.parse(await readFile(new URL('package.json',root),'utf8'));
+  assert.equal(pkg.version,expectedVersion);
+  const processBytes=await readFile(new URL('lib/Utils/process-message.js',root));
+  const receiveBytes=await readFile(new URL('lib/Socket/messages-recv.js',root));
+  const {default:processMessage}=await import(new URL('lib/Utils/process-message.js',root));
+  const {proto}=await import(new URL('WAProto/index.js',root));
+  const types=proto.Message.ProtocolMessage.Type;
+
+  async function run(name,body,fromMe){
+    const logs=[],events=[],cacheCalls=[],mappingCalls=[],accesses=[];
+    const logger={info:(_data,msg)=>logs.push(['info',msg]),warn:(_data,msg)=>logs.push(['warn',msg]),
+      debug:()=>{},trace:()=>{},error:()=>{},child(){return this;}};
+    const protocol=new Proxy({type:types[name],...body},{get(target,key,receiver){accesses.push(key);return Reflect.get(target,key,receiver);}});
+    const remoteJid=name==='GROUP_MEMBER_LABEL_CHANGE'?'123456789012345@g.us':'994500000001@s.whatsapp.net';
+    const message={key:{remoteJid,fromMe,id:'SYNTHETIC_MESSAGE',participant:'994500000002@s.whatsapp.net'},
+      messageTimestamp:1700000000,message:{protocolMessage:protocol}};
+    const context={shouldProcessHistoryMsg:false,ev:{emit:(...args)=>events.push(args)},
+      creds:{me:{id:'994500000000@s.whatsapp.net'},accountSettings:{}},
+      placeholderResendCache:{del:async value=>cacheCalls.push(value)},
+      keyStore:{transaction:async()=>{throw Error('Unexpected key-store transaction');},set:async()=>{throw Error('Unexpected key-store write');}},
+      signalRepository:{lidMapping:{storeLIDPNMappings:async pairs=>mappingCalls.push(pairs)},migrateSession:async()=>{throw Error('Unexpected session migration');}},
+      logger,options:{},getMessage:async()=>undefined};
+    await processMessage(message,context);
+    assert.equal(events.some(([event])=>event==='messages.upsert'),false,'No nested messages in neutral fixtures');
+    return {logs,events,cacheCalls,mappingCalls,accesses};
+  }
+
+  const fixtures=[
+    ['HISTORY_SYNC_NOTIFICATION',{historySyncNotification:{}},r=>r.logs.some(([,msg])=>msg==='got history notification')],
+    ['APP_STATE_SYNC_KEY_SHARE',{appStateSyncKeyShare:{keys:[]}},r=>r.logs.some(([,msg])=>msg==='recv app state sync with 0 keys')],
+    ['PEER_DATA_OPERATION_REQUEST_RESPONSE_MESSAGE',{peerDataOperationRequestResponseMessage:{stanzaId:'SYNTHETIC_STANZA',peerDataOperationResult:[]}},r=>r.accesses.includes('peerDataOperationRequestResponseMessage')],
+    ['LID_MIGRATION_MAPPING_SYNC',{lidMigrationMappingSyncMessage:{encodedMappingPayload:Buffer.alloc(0)}},r=>r.mappingCalls.length===1],
+  ];
+  for(const [name,body,visited] of fixtures){
+    const incoming=await run(name,body,false);
+    if(label==='rc13'){
+      assert.equal(visited(incoming),false,`${name}: non-self guard`);
+      assert.equal(incoming.logs.some(([level,msg])=>level==='warn'&&msg?.includes('dropping spoofed self-only protocolMessage')),true,`${name}: guard logged`);
+    }else assert.equal(visited(incoming),true,`${name}: rc9 reaches branch with inert fixture`);
+    const own=await run(name,body,true);
+    assert.equal(visited(own),true,`${name}: self-origin remains handled`);
+  }
+
+  const revoke=await run('REVOKE',{key:{id:'SYNTHETIC_OLD'}},false);
+  assert.equal(revoke.events.some(([event])=>event==='messages.update'),true,'Cross-user revoke remains handled');
+  const edit=await run('MESSAGE_EDIT',{key:{id:'SYNTHETIC_OLD'},editedMessage:{conversation:'SYNTHETIC'}},false);
+  assert.equal(edit.events.some(([event])=>event==='messages.update'),true,'Cross-user edit remains handled');
+  const ephemeral=await run('EPHEMERAL_SETTING',{ephemeralExpiration:3600},false);
+  assert.equal(ephemeral.events.some(([event])=>event==='chats.update'),true,'Cross-user ephemeral setting remains handled');
+  if(label==='rc13'){
+    const labelChange=await run('GROUP_MEMBER_LABEL_CHANGE',{memberLabel:{label:'SYNTHETIC'}},false);
+    assert.equal(labelChange.events.some(([event])=>event==='group.member-tag.update'),true,'Cross-user label remains handled');
+  }
+  results[label]={version:pkg.version,processSha256:createHash('sha256').update(processBytes).digest('hex'),
+    receiveSha256:createHash('sha256').update(receiveBytes).digest('hex')};
+}
+assert.equal(networkAttempts,0);
+process.stdout.write(JSON.stringify({result:'PASS',offline:true,fixtures:'neutral only',versions:results},null,2)+'\n');
