@@ -0,0 +1,139 @@
+# Draft deployment and rollback plan — NOT approved for production
+
+## Scope and actual status
+
+The base is upstream Evolution tag 2.3.7 (`cd800f2976e1e5b682fbf86a01ee4d85ae61f370`).
+The reserved-ID patch has no route or real caller; the durable ledger and
+identity checks in `poc/` are simulated and are not an implementation in
+Evolution, Connect or Worker. Stock `package.json` remains on Baileys
+`7.0.0-rc.9`. Hence the current tree cannot provide the intended production
+feature. Do not merge or deploy it merely because the local tests pass.
+
+Production image inspection reported Evolution 2.3.7 with rc9; the two
+inspected Baileys files matched npm rc9. Record the **full** current production
+image digest and both current deployment and Git SHA afresh before any action;
+a tag, version string, or old report is insufficient. Confirm the image build
+provenance and verify the actual Evolution handler and module resolution in the
+built artifact against the reviewed source. Do not claim the complete image
+matches the tag solely from these two hashes.
+
+The production-path guard **always refuses** correlated calls before lookup or
+conversion. There is no opt-in, version allowlist, checksum bypass or runtime
+switch. Legacy noncorrelated calls remain on the original path. The previous
+three-file rc13 check failed to cover signature-verification behavior and has
+been removed. The guard does not inspect or certify the image or its runtime.
+The synthetic-only harness can replace the guard to test unrelated ID plumbing;
+that is not an enablement path for a deployed service.
+
+Independent offline checks on the locally inspected rc9 image and a separate
+rc13 npm copy found `Curve.verify` returns success for an invalid signature
+when `libsignal.verifySignature` returns false without throwing. rc13 invokes
+this wrapper when checking Noise certificate signatures; both inspected
+versions call it for account signature checking during pairing. Other checks,
+including pairing HMAC and rc13's Noise issuer check, remain present. In both
+inspected `libsignal` copies, the outgoing session builder also calls the
+signature verifier with `isInit=true`, for which that implementation returns
+true; its security implications require separate assessment. These are local
+code and neutral fixture findings, not proof of real exploitation, production
+compromise or a complete protocol assessment. The rc9 image also has the
+separate GHSA noted below. Do not treat any matching file digest as a fix.
+
+## Mandatory decisions before third-repository or production changes
+
+1. Owner approval for modifying/forking the separate Evolution repository,
+   building and running a new Evolution production image, and any operational
+   maintenance window or interruption. This local branch has not received it.
+2. Select an independently reviewed, supported Baileys version and image;
+   fix and assess the signature-verification findings above. Unmodified rc13
+   is known to contain the wrapper issue and is not an approved fix.
+   Resolve GHSA-qvv5-jq5g-4cgg with a tested remediation, including the
+   existing nonvoice workload, and assess other advisories. The finding affects
+   the existing image, not only this experimental voice feature. Escalate
+   separately; no conclusion about actual exploitation has been established.
+3. Approve voice API budget/limits and a controlled test account/contact before
+   paid calls or any real WhatsApp send. Obtain consent and agree on data
+   retention; no real client contact may be used without separate permission.
+
+## Prerequisites before release
+
+* Build a reproducible immutable candidate image from reviewed source, pinned
+  base digest and lockfile; perform full TypeScript/build, vulnerability,
+  licence, dependency and image scans. Pin and record the complete digest and
+  SBOM. Explicitly upgrade and test Evolution's Baileys dependency; this PoC
+  does **not** upgrade it. Confirm 2.3.7/selected-Baileys compatibility,
+  session migration/rollback, receiving, reconnect, groups, text, audio, media,
+  receipt and webhook behavior in an isolated environment with no customers.
+* Implement and independently review the real authenticated internal API and
+  ledger: authorization and current tenant/channel/session identity checked at
+  prepare and commit; stable recipient, media digest and ID bound to a durable
+  intent; atomic claim committed before provider call; one claim only; no
+  blind retry after timeout/crash; replay and rotation handling; scoped reads;
+  unknown remains unknown until trustworthy evidence resolves it. This local
+  PoC's callbacks are not those controls. Groups remain unsupported.
+* Verify webhook origin and semantics end-to-end, including the actual Baileys
+  receive path, downstream event signing and identity checks. Internal HMAC
+  proves the forwarding hop, not the original WhatsApp author. An exact ID,
+  `fromMe`, or `getDevice` ID pattern alone is not authentication. A repaired
+  signature verifier would not alone prove all webhook inputs or authors authentic. Until
+  sufficient proof exists, retain `unknown` and existing protective behavior;
+  never infer origin from timing or remove protection from old unknown sends.
+* Audit existing per-instance speech-to-text and AI rules without disclosing
+  credentials. Evolution has optional audio transcription side effects. Verify
+  the exact inbound and outbound paths, existing consent and budget with
+  isolated mocked external calls and the owner's configuration decision.
+  Prevent new unintended STT/AI calls, charges or stored audio; don't silently
+  disable the tenant's existing processing. The local bridge stubs this path
+  and proves nothing about production configuration.
+* Establish exact-head independent review and CI for all changed repos, tests
+  for races, failover, in-flight revocation, tenant and channel isolation,
+  kill-switch propagation, idempotency, retention and restore. Stage with real
+  auth rules and disposable databases; verify no unexpected migrations. Verify
+  all listed rollback artifacts before touching production. Do not alter old
+  HOLD PRs, unrelated AI settings, roles or customer data.
+
+## Ordered release, only after prerequisites and approvals
+
+1. Capture fresh `main` heads and deployed image digest and health; confirm no
+   parallel changes conflict. Preserve immutable previous images, configuration
+   and DB schema compatibility. Never print credentials. Independently validate
+   exact candidate image provenance, dependency runtime and refusal behavior.
+2. Deploy the reviewed security-compatible Evolution image with the new voice
+   path disabled; check service health and legacy text/media/receive/webhook
+   regression. A mere successful deployment is not acceptance. If the image
+   fails validation, stop; do not switch on the voice path.
+3. Release compatible backend components with voice disabled and non-destructive
+   backward-compatible migrations only if separately reviewed. Verify that
+   capability endpoints refuse sending and that old clients and rollback work.
+4. Enable only on a specifically authorized test tenant/channel and test contact,
+   with bounded usage. Verify real delivery and receipt; audio must not cause
+   unapproved STT. Exercise duplicates, timeouts, concurrent sends, connection
+   changes and recovery without sending to customers. Monitor health, error,
+   unknown and dispatch counts, consent and cost; never log audio or secrets.
+   Test voice assistant separately under its own budget and credentials.
+5. Expand only after owner acceptance of observed behavior, attribution limits,
+   costs, rollback and independent security review. Acceptance must distinguish
+   real-provider evidence from mocks; this document asserts no real delivery.
+
+## Stop and rollback
+
+1. On unexpected sends, provenance ambiguity, duplicate relay, credential or
+   permission failure, unauthorized STT, incompatible runtime or degraded
+   service: disable voice at Worker/Connect and deny the internal endpoint;
+   verify propagation and stop new preparations and claims. A future runtime
+   gate must not be treated as an instantaneous kill switch for work already claimed.
+2. Drain or classify in-flight work; a request after provider dispatch may have
+   succeeded even with no response. Preserve all claimed/unknown IDs and audio
+   recovery state; no retry, cancellation, expiry or rollback may make the same
+   intent send again. Never infer safety from the absence of a receipt.
+3. Roll back downstream components only to versions that preserve the durable
+   ledger and correctly refuse the new protocol. Keep feature off and verify
+   scope isolation and legacy service health. Use the reviewed immutable image
+   and documented backward-compatible schema. Do not delete the ledger or
+   clear existing channel protections.
+4. Prefer a previously validated **security-fixed** Evolution image. The known
+   rc9 image is vulnerable; reverting to it is not an acceptable routine
+   rollback. If there is no compatible fixed image, isolate or stop the affected
+   integration and escalate the availability/security decision to the owner;
+   do not silently re-enable the vulnerable image. Check session compatibility
+   and event queues before reconnecting. Preserve evidence and reassess before
+   retrying a release.
diff --git a/poc/evolution-test-bridge.cjs b/poc/evolution-test-bridge.cjs
new file mode 100644
index 0000000..80f60b8
--- /dev/null
+++ b/poc/evolution-test-bridge.cjs
@@ -0,0 +1,44 @@
+// LOCAL TEST HARNESS: extract actual patched upstream methods; every external
+// dependency and post-send side effect is replaced with synthetic callbacks.
+// Its default no-op guard is a TEST-ONLY synthetic bypass in this file, never
+// imported by the service; runtime-guard.test.cjs separately tests the real
+// unconditionally closed guard against the extracted service entry points.
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const vm=require('node:vm');
+const ts=require('/workspace/voice-beintaskbot-connect/node_modules/typescript');
+const path=require('node:path');
+const file=path.resolve(__dirname,'../src/api/integrations/channel/whatsapp/whatsapp.baileys.service.ts');
+const source=fs.readFileSync(file,'utf8');
+const tree=ts.createSourceFile(file,source,ts.ScriptTarget.Latest,true,ts.ScriptKind.TS);
+const original=tree.statements.find(s=>ts.isClassDeclaration(s)&&s.name?.text==='BaileysStartupService');
+assert.ok(original,'actual upstream class exists');
+const members=['sendMessage','sendMessageWithTyping','audioWhatsapp'].map(name=>{
+  const item=original.members.find(m=>m.name?.getText(tree)===name);
+  assert.ok(item,`actual upstream method ${name} exists`);return item.getFullText(tree);
+});
+const code=ts.transpileModule(`class ExtractedEvolution { ${members.join('\n')} }; globalThis.ExtractedEvolution=ExtractedEvolution;`,
+  {compilerOptions:{target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.None}}).outputText;
+class FakeBadRequest extends Error {}
+const sandbox={Buffer,console,Date,assertVoiceCorrelationRuntime:()=>{},BadRequestException:FakeBadRequest,InternalServerErrorException:FakeBadRequest,NotFoundException:FakeBadRequest,
+  isURL:()=>false,isBase64:()=>true,isJidGroup:jid=>jid.endsWith('@g.us'),Long:{isLong:()=>false},Events:{SEND_MESSAGE:'send.message'}};
+vm.runInNewContext(code,sandbox,{filename:'extracted-evolution-2.3.7.js'});
+function make(sendMessage, assertRuntime=()=>{}){
+  sandbox.assertVoiceCorrelationRuntime=assertRuntime;
+  const api=new sandbox.ExtractedEvolution(),calls=[],events=[];
+  api.whatsappNumber=async({numbers})=>[{exists:true,jid:api.resolvedJid||numbers[0]}];
+  api.logger={verbose:()=>{},error:()=>{},warn:()=>{}};
+  api.processAudio=async()=>Buffer.from('synthetic-preconverted-audio');
+  api.instance={wuid:'994500000001@s.whatsapp.net',name:'synthetic'};
+  api.localWebhook={enabled:false};
+  api.configService={get:key=>key==='DATABASE'?{SAVE_DATA:{NEW_MESSAGE:false}}:{ENABLED:false}};
+  api.prepareMessage=message=>({key:message.key,message:{audioMessage:{ptt:true}}});
+  api.sendDataWebhook=(type,data)=>events.push({type,data});
+  api.client={sendMessage:async(jid,message,options)=>{
+    calls.push({jid,message,options});
+    if(sendMessage)return sendMessage(jid,message,options);
+    return {key:{id:options.messageId||'LEGACY_GENERATED',remoteJid:jid,fromMe:true},message:{audioMessage:{ptt:true}}};
+  }};
+  return {api,calls,events};
+}
+module.exports={make};
