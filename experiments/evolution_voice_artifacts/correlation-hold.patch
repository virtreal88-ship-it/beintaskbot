+ * This experiment cannot be enabled in a deployed build. The reviewed rc9 and
+ * rc13 dependency combinations have unresolved signature-verification issues.
+ * Replacing this denial requires a separate independently accepted security fix,
+ * full runtime/image verification and a new review; an environment variable,
+ * version string or partial file hashes are not sufficient authorization.
+ * Legacy calls without voice correlation do not enter this path.
+ */
+export function assertVoiceCorrelationRuntime(): void {
+  throw new Error('voice_correlation_unavailable');
+}
