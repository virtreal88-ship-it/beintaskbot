index 0000000..625962f
--- /dev/null
+++ b/poc-tests/baileys-real-offline.mjs
@@ -0,0 +1,124 @@
+// Exercises the installed Baileys implementation to the sendNode boundary.
+// All identities, crypto, media cache and transport below are synthetic.
+// Run: node /workspace/voice-evolution-poc/poc-tests/baileys-real-offline.mjs
+// Requires Node.js 22.15+ (module.registerHooks); verified with Node.js 24.
+import assert from 'node:assert/strict';
+import { EventEmitter } from 'node:events';
+import { createRequire, registerHooks, syncBuiltinESMExports } from 'node:module';
+import net from 'node:net';
+import tls from 'node:tls';
+import http from 'node:http';
+import https from 'node:https';
+
+let networkAttempts = 0;
+let queryAttempts = 0;
+const denyNetwork = () => { networkAttempts++; throw new Error('Unexpected network access'); };
+globalThis.fetch = denyNetwork;
+globalThis.WebSocket = class { constructor() { denyNetwork(); } };
+net.connect = net.createConnection = denyNetwork;
+net.Socket.prototype.connect = denyNetwork;
+tls.connect = denyNetwork;
+http.request = http.get = denyNetwork;
+https.request = https.get = denyNetwork;
+syncBuiltinESMExports();
+
+const root = 'file:///workspace/voice-poc-deps/node_modules/baileys/';
+const socketRoot = root + 'lib/Socket/';
+registerHooks({
+  load(url, context, nextLoad) {
+    // Avoid constructing a real WebSocket. messages-send.js itself remains real.
+    if (url === socketRoot + 'newsletter.js') {
+      return { format: 'module', source: 'export const makeNewsletterSocket = () => globalThis.__offlineBaileysSocket', shortCircuit: true };
+    }
+    return nextLoad(url, context);
+  },
+});
+
+const user = '994500000000:1@s.whatsapp.net';
+const recipient = process.env.VOICE_POC_DEST_JID || '994500000001@s.whatsapp.net';
+assert.match(recipient,/^[0-9]{5,22}@(s\.whatsapp\.net|lid)$/);
+const stanzas = [];
+const encrypted = [];
+const logger = {};
+for (const name of ['trace', 'debug', 'info', 'warn', 'error', 'fatal']) logger[name] = () => {};
+logger.child = () => logger;
+const unexpectedQuery = () => { queryAttempts++; throw new Error('Unexpected query or USync'); };
+globalThis.__offlineBaileysSocket = {
+  user: { id: user }, ev: new EventEmitter(),
+  authState: { creds: { me: { id: user } }, keys: { transaction: async (fn) => fn(), get: async () => ({}), set: async () => {} } },
+  processingMutex: { mutex: async (fn) => fn() },
+  signalRepository: {
+    jidToSignalProtocolAddress: (jid) => jid,
+    validateSession: async () => ({ exists: true }),
+    encryptMessage: async (input) => { encrypted.push(input); return { type: 'msg', ciphertext: Buffer.from([1]) }; },
+  },
+  upsertMessage: async () => {}, query: unexpectedQuery, executeUSyncQuery: unexpectedQuery,
+  sendNode: async (stanza) => { stanzas.push(stanza); }, fetchPrivacySettings: async () => ({}),
+  groupMetadata: unexpectedQuery, groupToggleEphemeral: unexpectedQuery,
+};
+
+const { proto } = await import(root + 'WAProto/index.js');
+const encodedAudio = proto.Message.encode(proto.Message.fromObject({
+  audioMessage: { mimetype: 'audio/ogg; codecs=opus', ptt: true, seconds: 1, directPath: '/synthetic' },
+})).finish();
+const mediaCache = {
+  // A cache hit prevents media processing, file creation, upload and network.
+  get: async (key) => { assert.equal(key, 'audio:https://offline.invalid/synthetic'); return encodedAudio; },
+  set: async () => { throw new Error('Unexpected media cache miss'); },
+};
+const { makeMessagesSocket } = await import(socketRoot + 'messages-send.js');
+const { generateMessageIDV2 } = await import(root + 'lib/Utils/generics.js');
+const { getDevice } = await import(root + 'lib/Utils/messages.js');
+const version = JSON.parse(await (await import('node:fs/promises')).readFile(new URL(root + 'package.json'), 'utf8')).version;
+assert.equal(version, '7.0.0-rc.9');
+const providerId = process.env.VOICE_POC_RESERVED_ID || generateMessageIDV2(user);
+const audio=Buffer.from(process.env.VOICE_POC_AUDIO_BASE64||Buffer.from('synthetic').toString('base64'),'base64');
+assert.ok(audio.length>0&&audio.length<=5*1024*1024);
+assert.match(providerId,/^3EB0[A-F0-9]{18}$/);
+const socket = makeMessagesSocket({
+  logger, mediaCache, options: {}, emitOwnEvents: false, patchMessageBeforeSending: async (message) => message,
+  userDevicesCache: { mget: async (users) => Object.fromEntries(users.map((value) => [value, [{ user: value, server: 's.whatsapp.net', device: 0 }]])) },
+});
+
+let message,evolutionReceipt;
+if(process.env.VOICE_POC_EVOLUTION_BRIDGE==='true'){
+  const require=createRequire(import.meta.url),{make}=require('../poc/evolution-test-bridge.cjs');
+  const {api,calls}=make(async(jid,upstreamAudio,options)=>{
+    assert.deepEqual(upstreamAudio.audio,audio);assert.equal(upstreamAudio.ptt,true);
+    // Replace only media bytes with a cache-key placeholder so the real
+    // Baileys media upload never touches disk or network. ID and route are
+    // passed unchanged through the patched Evolution methods.
+    message=await socket.sendMessage(jid,{...upstreamAudio,audio:{url:'https://offline.invalid/synthetic'},seconds:1},options);
+    return message;
+  });
+  const result=await api.audioWhatsapp({number:recipient,audio:audio.toString('base64'),encoding:false},undefined,false,
+    {messageId:providerId,expectedJid:recipient});
+  assert.equal(calls.length,1);assert.equal(calls[0].options.messageId,providerId);assert.equal(result.key.id,providerId);
+  evolutionReceipt={key:result.key,message:{audioMessage:{ptt:result.message.audioMessage.ptt}}};
+}else{
+  message = await socket.sendMessage(recipient, {
+    audio: { url: 'https://offline.invalid/synthetic' }, ptt: true, mimetype: 'audio/ogg; codecs=opus', seconds: 1,
+  }, { messageId: providerId });
+}
+assert.equal(message.key.id, providerId);
+assert.equal(message.key.remoteJid, recipient);
+assert.equal(message.key.fromMe, true);
+assert.equal(message.message.audioMessage.ptt, true);
+assert.equal(message.message.audioMessage.mimetype, 'audio/ogg; codecs=opus');
+assert.equal(stanzas.length, 1);
+assert.equal(stanzas[0].attrs.id, providerId);
+assert.equal(stanzas[0].attrs.to, recipient);
+const participants = stanzas[0].content.find((node) => node.tag === 'participants');
+assert.ok(participants?.content?.length);
+assert.equal(participants.content[0].content[0].attrs.mediatype, 'ptt');
+assert.ok(encrypted.length > 0);
+assert.equal(networkAttempts, 0);
+assert.equal(queryAttempts, 0);
+
+// getDevice predicts a label from the ID string; it is not author proof.
+assert.equal(getDevice(providerId), 'web');
+assert.equal(getDevice('3A' + 'A'.repeat(18)), 'ios');
+assert.equal(getDevice('A'.repeat(21)), 'android');
+assert.equal(getDevice('OTHER'), 'unknown');
+if(process.env.VOICE_POC_JSON==='true')process.stdout.write(JSON.stringify({providerId,jid:recipient,socketUser:user,fromMe:true,ptt:true,evolutionReceipt,source:getDevice(providerId),networkAttempts,queryAttempts})+'\n');
+else process.stdout.write('PASS Baileys 7.0.0-rc.9 offline: supplied ID, exact JID and PTT reach intercepted sendNode; source is only an ID-pattern prediction.\n');
diff --git a/poc-tests/evolution-bridge.test.cjs b/poc-tests/evolution-bridge.test.cjs
new file mode 100644
index 0000000..6723da4
--- /dev/null
+++ b/poc-tests/evolution-bridge.test.cjs
@@ -0,0 +1,85 @@
+// Extract the actual three patched Evolution 2.3.7 methods with the TypeScript
+// parser, transpile them, and run them with all provider/side effects faked.
+// This is a local path test, not a whole-service build or WhatsApp test.
+const {test}=require('node:test');
+const assert=require('node:assert/strict');
+const {make}=require('../poc/evolution-test-bridge.cjs');
+const jid='994500000000@s.whatsapp.net',id='3EB0ABCDEF123456789ABC';
+
+test('synthetic guard bypass: both extracted audio paths pass the exact ID to a fake client',async()=>{
+  for(const encoding of [false,true]){
+    const {api,calls,events}=make();
+    const result=await api.audioWhatsapp({number:jid,audio:'synthetic-base64',encoding},undefined,false,{messageId:id,expectedJid:jid});
+    assert.equal(calls.length,1);assert.equal(calls[0].jid,jid);assert.equal(calls[0].options.messageId,id);
+    assert.equal(calls[0].message.ptt,true);assert.equal(result.key.id,id);assert.equal(events.length,1);
+  }
+});
+test('synthetic guard bypass: route change, group, malformed ID or media fail',async()=>{
+  for(const [resolved,correlation] of [
+    ['994599999999@s.whatsapp.net',{messageId:id,expectedJid:jid}],
+    ['123456789012345@g.us',{messageId:id,expectedJid:jid}],
+    [jid,{messageId:'bad-id',expectedJid:jid}],
+    [jid,{messageId:id,expectedJid:'invalid'}],
+  ]){
+    const {api,calls}=make();api.resolvedJid=resolved;
+    await assert.rejects(api.audioWhatsapp({number:jid,audio:'synthetic-base64',encoding:false},undefined,false,correlation),/voice_correlation_scope_conflict/);
+    assert.equal(calls.length,0);
+  }
+  const {api,calls}=make();
+  await assert.rejects(api.sendMessageWithTyping(jid,{conversation:'not audio'},undefined,false,{messageId:id,expectedJid:jid}),/voice_correlation_scope_conflict/);
+  assert.equal(calls.length,0);
+});
+test('synthetic harness: existing callers without internal correlation remain unchanged',async()=>{
+  const {api,calls}=make();
+  const result=await api.audioWhatsapp({number:jid,audio:'synthetic-base64',encoding:false});
+  assert.equal(calls.length,1);assert.equal(calls[0].options.messageId,undefined);assert.equal(result.key.id,'LEGACY_GENERATED');
+});
+test('refused runtime stops before route lookup, audio processing or relay; legacy remains available',async()=>{
+  const {api,calls}=make(undefined,()=>{throw Error('voice_correlation_unavailable')});
+  let touched=0;
+  api.whatsappNumber=async()=>{touched++;throw Error('route should not run')};
+  api.processAudio=async()=>{touched++;throw Error('conversion should not run')};
+  await assert.rejects(api.audioWhatsapp({number:jid,audio:'synthetic-base64',encoding:true},undefined,false,{messageId:id,expectedJid:jid}),/voice_correlation_unavailable/);
+  await assert.rejects(api.sendMessageWithTyping(jid,{audio:Buffer.from('synthetic'),ptt:true},undefined,false,{messageId:id,expectedJid:jid}),/voice_correlation_unavailable/);
+  assert.equal(touched,0);assert.equal(calls.length,0);
+});
+test('synthetic guard bypass: changing getters are read once and snapshot is sent',async()=>{
+  for(const entry of ['direct','audio']){
+    const {api,calls}=make();
+    let idReads=0,jidReads=0;
+    const correlation={
+      get messageId(){return ++idReads===1?id:'3EB0FFFFFFFFFFFFFFFFFF'},
+      get expectedJid(){return ++jidReads===1?jid:'994599999999@s.whatsapp.net'},
+    };
+    const result=entry==='direct'
+      ? await api.sendMessageWithTyping(jid,{audio:Buffer.from('synthetic'),ptt:true},undefined,false,correlation)
+      : await api.audioWhatsapp({number:jid,audio:'synthetic-base64',encoding:true},undefined,false,correlation);
+    assert.equal(idReads,1);assert.equal(jidReads,1);
+    assert.equal(result.key.id,id);assert.equal(calls.length,1);assert.equal(calls[0].options.messageId,id);
+  }
+});
+test('synthetic guard bypass: async mutation cannot change captured ID or JID',async()=>{
+  for(const entry of ['direct','audio']){
+    const {api,calls}=make();
+    const correlation={messageId:id,expectedJid:jid};
+    const change=()=>{correlation.messageId='3EB0FFFFFFFFFFFFFFFFFF';correlation.expectedJid='994599999999@s.whatsapp.net'};
+    if(entry==='direct')api.whatsappNumber=async()=>{await Promise.resolve();change();return [{exists:true,jid}];};
+    else api.processAudio=async()=>{await Promise.resolve();change();return Buffer.from('synthetic');};
+    const result=entry==='direct'
+      ? await api.sendMessageWithTyping(jid,{audio:Buffer.from('synthetic'),ptt:true},undefined,false,correlation)
+      : await api.audioWhatsapp({number:jid,audio:'synthetic-base64',encoding:true},undefined,false,correlation);
+    assert.equal(result.key.id,id);assert.equal(calls.length,1);assert.equal(calls[0].jid,jid);assert.equal(calls[0].options.messageId,id);
+  }
+});
+test('synthetic guard bypass: non-primitive values fail before async work',async()=>{
+  for(const entry of ['direct','audio']){
+    const {api,calls}=make();let touched=0;
+    api.whatsappNumber=async()=>{touched++;throw Error('unexpected lookup')};
+    api.processAudio=async()=>{touched++;throw Error('unexpected conversion')};
+    const correlation={messageId:new String(id),expectedJid:jid};
+    await assert.rejects(entry==='direct'
+      ? api.sendMessageWithTyping(jid,{audio:Buffer.from('synthetic'),ptt:true},undefined,false,correlation)
+      : api.audioWhatsapp({number:jid,audio:'synthetic-base64',encoding:true},undefined,false,correlation),/voice_correlation_scope_conflict/);
+    assert.equal(touched,0);assert.equal(calls.length,0);
+  }
+});
diff --git a/poc-tests/protocol-postgres.test.mjs b/poc-tests/protocol-postgres.test.mjs
new file mode 100644
index 0000000..2c1b7c8
--- /dev/null
+++ b/poc-tests/protocol-postgres.test.mjs
@@ -0,0 +1,168 @@
+// Tests use a disposable localhost PostgreSQL container and synthetic relay.
+import test,{before,after} from 'node:test';
+import assert from 'node:assert/strict';
+import {createHash,randomUUID} from 'node:crypto';
+import {createRequire} from 'node:module';
+import {spawn} from 'node:child_process';
+import {resolve} from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {VoiceIntentPrototype,localPool,schema,syntheticScope,syntheticAudio} from '../poc/protocol.mjs';
+
+const require=createRequire(resolve(process.env.VOICE_POC_DEPS||'/workspace/voice-poc-deps','index.js'));
+const {Pool}=require('pg');
+const base=new URL(process.env.VOICE_POC_ADMIN_URL||'');
+const parsedAdmin=require('pg-connection-string').parse(base.toString());
+if(!['postgres:','postgresql:'].includes(base.protocol)||base.search||base.hash||
+   !['localhost','127.0.0.1','::1','[::1]'].includes(base.hostname)||
+   !['localhost','127.0.0.1','::1','[::1]'].includes(parsedAdmin.host)||base.pathname!=='/postgres')throw Error('localhost_synthetic_admin_only');
+const name='test_voice_corr_'+randomUUID().replaceAll('-','');
+const admin=new Pool({connectionString:base.toString(),max:1});base.pathname='/'+name;
+let pool;
+before(async()=>{await admin.query(`CREATE DATABASE "${name}"`);pool=localPool(base.toString());await pool.query(schema);});
+after(async()=>{await pool?.end();await new Promise(resolve=>setTimeout(resolve,150));await admin.query(`DROP DATABASE IF EXISTS "${name}"`);await admin.end();});
+const allow=async()=>{};
+const socketIdentity=async()=>({instance:'synthetic-instance',accountEpoch:'synthetic-session',senderJid:'994500000000:1@s.whatsapp.net'});
+const engine=options=>new VoiceIntentPrototype(pool,{socketIdentity,...options});
+const commit=(a,s,options={})=>a.commit(s,{audio:syntheticAudio(),...options});
+const fixture=()=>{let calls=0;const requests=[];return {calls:()=>calls,requests,relay:async input=>{calls++;requests.push(input);return {key:{id:input.providerId,remoteJid:input.actualJid,fromMe:true},message:{audioMessage:{ptt:true}}};}};};
+const event=(s,id)=>({tenant:s.tenant,channel:s.channel,instance:s.instance,accountEpoch:s.accountEpoch,jid:s.actualJid,providerId:id,fromMe:true,type:'audio'});
+
+test('database URL cannot override localhost through pg connection parameters',()=>{
+  assert.throws(()=>localPool(base.toString()+'?host=example.invalid'),/local_test_postgres_only/);
+});
+
+test('audio snapshot is bound before async authorization and wrong content is rejected',async()=>{
+  const s=syntheticScope(),f=fixture(),original=syntheticAudio();let mutate=false;
+  const a=engine({authorize:async(x,stage)=>{if(mutate&&stage==='commit')original.fill(0);},relay:f.relay});
+  await a.prepare(s);
+  await assert.rejects(a.commit(s,{audio:Buffer.from('wrong')}),/audio_content_conflict/);
+  assert.equal((await a.read(s)).state,'prepared');
+  mutate=true;assert.equal((await a.commit(s,{audio:original})).state,'accepted');
+  assert.deepEqual(f.requests[0].audio,syntheticAudio());assert.notDeepEqual(original,syntheticAudio());
+});
+
+test('changed synthetic socket identity cannot claim an existing operation',async()=>{
+  const s=syntheticScope(),f=fixture();let sender='994500000000:1@s.whatsapp.net';
+  const a=engine({authorize:allow,relay:f.relay,socketIdentity:async()=>({...await socketIdentity(),senderJid:sender})});
+  await a.prepare(s);sender='994599999999:1@s.whatsapp.net';
+  await assert.rejects(commit(a,s),/verified_socket_changed/);
+  assert.equal((await a.read(s)).state,'prepared');assert.equal(f.calls(),0);
+});
+
+test('instance remap cannot create a second operation for accepted or unknown send',async()=>{
+  for(const unknown of [false,true]){
+    const s=syntheticScope(),f=fixture();let instance=s.instance;
+    const a=engine({authorize:allow,socketIdentity:async()=>({...await socketIdentity(),instance}),
+      relay:async i=>{const response=await f.relay(i);if(unknown)throw Error('unknown');return response;}});
+    await a.prepare(s);assert.equal((await commit(a,s)).state,unknown?'claimed':'accepted');
+    instance='remapped-instance';const remapped={...s,instance};
+    await assert.rejects(a.prepare(remapped),/scope_or_content_conflict/);
+    await assert.rejects(commit(a,remapped),/scope_or_content_conflict/);
+    assert.equal(f.calls(),1);
+  }
+});
+
+test('process death after claim or during relay cannot cause a new relay after restart',async()=>{
+  const script=fileURLToPath(new URL('./restart-worker.mjs',import.meta.url));
+  const run=(mode,scope)=>new Promise((resolvePromise,reject)=>{
+    const child=spawn(process.execPath,[script],{env:{PATH:process.env.PATH,VOICE_POC_DB_URL:base.toString(),VOICE_POC_SCOPE:JSON.stringify(scope),VOICE_POC_MODE:mode},stdio:['ignore','pipe','pipe']});
+    let stdout='',stderr='';child.stdout.on('data',v=>stdout+=v);child.stderr.on('data',v=>stderr+=v);
+    const timeout=setTimeout(()=>child.kill('SIGKILL'),15000);
+    child.on('error',reject);child.on('close',code=>{clearTimeout(timeout);resolvePromise({code,stdout,stderr});});
+  });
+  for(const [mode,exitCode] of [['exit-after-claim',71],['exit-in-relay',72]]){
+    const scope=syntheticScope(),f=fixture(),p=engine({authorize:allow,relay:f.relay});await p.prepare(scope);
+    const killed=await run(mode,scope);assert.equal(killed.code,exitCode,killed.stderr);
+    const restarted=await run('retry',scope);assert.equal(restarted.code,0,restarted.stderr);
+    assert.deepEqual(JSON.parse(restarted.stdout),{state:'claimed',calls:0});assert.equal(f.calls(),0);
+  }
+});
+
+test('prepare is durable and idempotent; a changed scope or audio never reuses the request',async()=>{
+  const s=syntheticScope(),f=fixture(),a=engine({authorize:allow,relay:f.relay});
+  const rows=await Promise.all(Array.from({length:16},()=>a.prepare(s)));
+  assert.equal(new Set(rows.map(r=>r.provider_id)).size,1);assert.match(rows[0].provider_id,/^3EB0[A-F0-9]{18}$/);assert.equal(f.calls(),0);
+  assert.equal((await engine({authorize:allow,relay:f.relay}).read(s)).provider_id,rows[0].provider_id);
+  for(const changes of [{audioHash:'c'.repeat(64)},{paramsHash:'c'.repeat(64)},{actor:21},{accountEpoch:'another-session'},
+    {expectedJid:'994599999999@s.whatsapp.net',actualJid:'994599999999@s.whatsapp.net'}]){
+    await assert.rejects(a.prepare({...s,...changes}),/scope_or_content_conflict|verified_socket_changed/);
+  }
+  assert.equal(await a.read({...s,tenant:randomUUID()}),null);
+  assert.equal(await a.read({...s,channel:randomUUID()}),null);
+});
+
+test('concurrent commit: exactly one local relay attempt and scoped positive facts only',async()=>{
+  const s=syntheticScope(),f=fixture(),a=engine({authorize:allow,relay:f.relay});
+  const reserved=await a.prepare(s),results=await Promise.all(Array.from({length:20},()=>commit(a,s)));
+  assert.equal(f.calls(),1);assert.equal(f.requests[0].providerId,reserved.provider_id);
+  assert.ok(results.every(r=>['claimed','accepted'].includes(r.state)));
+  assert.equal((await a.read(s)).state,'accepted');assert.equal(await a.matchEvent(s,event(s,reserved.provider_id)),true);
+  for(const change of [{tenant:randomUUID()},{channel:randomUUID()},{instance:'wrong-instance'},
+    {accountEpoch:'wrong-session'},{jid:'994599999999@s.whatsapp.net'},{providerId:'3EB0000000000000000000'},
+    {fromMe:false},{type:'text'}])assert.equal(await a.matchEvent(s,{...event(s,reserved.provider_id),...change}),false);
+  assert.equal(f.calls(),1);
+});
+
+test('lost response, mismatched response, and crash after claim never allow a second relay',async()=>{
+  for(const mode of ['throw','wrong-id','wrong-jid','wrong-direction','wrong-media','crash']){
+    const s=syntheticScope();let calls=0;
+    const relay=async i=>{calls++;if(mode==='throw')throw Error('lost');return {key:{id:mode==='wrong-id'?'3EB0000000000000000000':i.providerId,
+      remoteJid:mode==='wrong-jid'?'994599999999@s.whatsapp.net':i.actualJid,fromMe:mode!=='wrong-direction'},message:{audioMessage:{ptt:mode!=='wrong-media'}}};};
+    const a=engine({authorize:allow,relay});await a.prepare(s);
+    if(mode==='crash')await assert.rejects(commit(a,s,{crashAfterClaim:true}),/simulated_process_death/);else await commit(a,s);
+    const restarted=engine({authorize:allow,relay});
+    assert.equal((await restarted.read(s)).state,'claimed');assert.equal((await commit(restarted,s)).state,'claimed');
+    assert.equal(calls,mode==='crash'?0:1);assert.equal(await restarted.cancel(s),false);
+  }
+});
+
+test('cancel races atomically with claim, never sends twice or reopens tombstones',async()=>{
+  for(let i=0;i<12;i++){
+    const s=syntheticScope(),f=fixture(),a=engine({authorize:allow,relay:f.relay});await a.prepare(s);
+    const [cancelled]=await Promise.all([a.cancel(s),commit(a,s)]),row=await a.read(s);
+    assert.equal(f.calls(),cancelled?0:1);assert.equal(row.state,cancelled?'cancelled':'accepted');
+    await a.prepare(s);await commit(a,s);assert.equal(f.calls(),cancelled?0:1);
+  }
+});
+
+test('scope, route or permission revocation stops before synthetic relay; no auto-retry after claim',async()=>{
+  const s=syntheticScope(),f=fixture();let allowed=true,route=s.actualJid,session=s.accountEpoch;
+  const authorize=async (x,stage)=>{if(!allowed||route!==x.actualJid||session!==x.accountEpoch)throw Error('authorization_changed');};
+  const a=engine({authorize,relay:f.relay});
+  await assert.rejects(a.prepare({...s,actualJid:'994599999999@s.whatsapp.net'}),/authorization_changed|unverified_route/);
+  await a.prepare(s);allowed=false;await assert.rejects(commit(a,s),/authorization_changed/);assert.equal(f.calls(),0);
+  allowed=true;route='994599999999@s.whatsapp.net';await assert.rejects(commit(a,s),/authorization_changed/);assert.equal(f.calls(),0);
+  route=s.actualJid;session='different-session';await assert.rejects(commit(a,s),/authorization_changed/);assert.equal(f.calls(),0);
+  session=s.accountEpoch;let stages=0;
+  const b=engine({authorize:async(x,stage)=>{if(stage==='dispatch')throw Error('revoked');stages++;},relay:f.relay});
+  assert.equal((await commit(b,s)).state,'claimed');assert.equal(f.calls(),0);assert.equal((await commit(a,s)).state,'claimed');
+});
+
+test('persisted provider ID reaches patched Evolution and real Baileys sendNode in an offline child',async()=>{
+  const s={...syntheticScope(),audioHash:createHash('sha256').update('synthetic').digest('hex')};let calls=0,result;
+  const relay=async ({providerId,actualJid,audio,ptt,encoding,mime})=>{
+    calls++;
+    assert.equal(createHash('sha256').update(audio).digest('hex'),s.audioHash);
+    assert.deepEqual({ptt,encoding,mime},{ptt:true,encoding:false,mime:'audio/ogg'});
+    const script=fileURLToPath(new URL('./baileys-real-offline.mjs',import.meta.url));
+    result=await new Promise((resolvePromise,reject)=>{
+      const child=spawn(process.execPath,[script],{env:{PATH:process.env.PATH,VOICE_POC_EVOLUTION_BRIDGE:'true',VOICE_POC_JSON:'true',
+        VOICE_POC_RESERVED_ID:providerId,VOICE_POC_DEST_JID:actualJid,VOICE_POC_AUDIO_BASE64:audio.toString('base64')},stdio:['ignore','pipe','pipe']});
+      let stdout='',stderr='';child.stdout.on('data',chunk=>stdout+=chunk);child.stderr.on('data',chunk=>stderr+=chunk);
+      const timeout=setTimeout(()=>child.kill('SIGKILL'),15000);
+      child.on('error',error=>{clearTimeout(timeout);reject(error);});
+      child.on('close',code=>{clearTimeout(timeout);if(code!==0)return reject(Error('synthetic child failed: '+stderr.slice(-2000)));
+        try{resolvePromise(JSON.parse(stdout));}catch(error){reject(error);}});
+    });
+    assert.equal(result.providerId,providerId);assert.equal(result.jid,actualJid);assert.equal(result.socketUser,(await socketIdentity()).senderJid);assert.equal(result.ptt,true);
+    assert.equal(result.networkAttempts,0);assert.equal(result.queryAttempts,0);
