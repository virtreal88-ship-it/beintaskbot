+import { useEffect, useRef, useState } from 'react';
+import { apiGet } from '@/lib/api';
+import { openLabOutgoingCall } from '@/lib/webrtc';
+import { registerOwnConnection } from '@/stores/calls';
+import { useDevices } from '@/stores/devices';
+import { endCall } from '@/services/calls';
+import { Button } from '@/components/ui/button';
+
+// Isolated lab only: the server exposes exactly one pre-approved destination.
+// An unknown launch keeps this control blocked until operator inspection.
+export const LabCallTest = ({sid,busy}:{sid:string;busy:boolean}) => {
+  const [profile,setProfile]=useState<{ready:boolean;call_test_peer?:string;call_test_max_seconds?:number}|null>(null);
+  const [consent,setConsent]=useState(false);
+  const [state,setState]=useState<'idle'|'starting'|'started'|'unknown'>('idle');
+  const [error,setError]=useState('');
+  const locked=useRef(false);
+  const micId=useDevices(s=>s.micId);
+  useEffect(()=>{let disposed=false;apiGet<typeof profile>('/api/unified-lab/status').then(p=>{if(!disposed)setProfile(p)}).catch(()=>{});return()=>{disposed=true}},[sid]);
+  if(!profile?.call_test_peer)return <p>Тестовый приём звонков. Исходящие вызовы отключены.</p>;
+  const start=async()=>{
+    if(locked.current||busy||!consent||!profile.ready)return;
+    locked.current=true;setState('starting');setError('');
+    try {
+      const {callId,conn}=await openLabOutgoingCall(sid,profile.call_test_peer!,crypto.randomUUID(),micId);
+      if(!registerOwnConnection(callId,conn)) {
+        await endCall(sid,callId).catch(()=>{});
+        throw new Error('Звонок завершился до подключения звука');
+      }
+      setState('started');
+    } catch {setState('unknown');setError('Результат запуска требует проверки. Не запускайте новый звонок. Кнопка завершения доступна в карточке вызова, если он появился.');}
+  };
+  return <section className="space-y-3 rounded-xl border p-4">
+    <p>Единый WhatsApp: тестовый вызов только на …{profile.call_test_peer.split('@')[0].slice(-4)}. До {Math.floor((profile.call_test_max_seconds??0)/60)} минут.</p>
+    <label className="flex gap-2"><input type="checkbox" checked={consent} disabled={state!=='idle'} onChange={e=>setConsent(e.target.checked)}/>Участник согласен на запись обеих сторон. Тестовая запись хранится 24 часа.</label>
+    <Button disabled={busy||!consent||!profile.ready||state!=='idle'} onClick={()=>void start()}>{state==='starting'?'Подключение…':state==='started'?'Тестовый вызов запущен':'Позвонить согласованному участнику'}</Button>
+    {error&&<p role="alert">{error}</p>}
+  </section>;
+};
