   await pc.setRemoteDescription({ type: "answer", sdp: sdp_answer });
 
   return {
@@ -82,3 +78,22 @@ export const openCall = async (
   };
   } catch(error) { close(); throw error; }
 };
+
+export const openCall = (sid: string, callId: string, micDeviceId: string | null): Promise<OpenCall> =>
+  openConnection(micDeviceId, async offer => {
+    const result = await apiPost<{ sdp_answer: string }>(`/api/sessions/${sid}/calls/${callId}/webrtc`, {sdp_offer:offer});
+    return result.sdp_answer;
+  });
+
+export const openLabOutgoingCall = async (sid: string, peer: string, operation: string, micDeviceId: string | null) => {
+  let callId = '';
+  const conn = await openConnection(micDeviceId, async offer => {
+    const result = await apiPost<{ok:boolean;provider_id:string;sdp_answer:string}>(`/api/unified-lab/calls`, {
+      operation,session_id:sid,peer,sdp_offer:offer,consent_confirmed:true,
+    });
+    if (!result.ok || !result.provider_id || !result.sdp_answer) throw new Error('Запуск не подтверждён; повторно не звоните');
+    callId=result.provider_id;
+    return result.sdp_answer;
+  });
+  return {callId,conn};
+};
