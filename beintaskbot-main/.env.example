# Example only. Put real values in the matching Railway service Variables.
# STAGING_MODE prevents importing/writing legacy production storage and forces
# AI Agent automatic sending and CRM actions off. Keep false in production.
STAGING_MODE=false
# Set false only for a separate staging deployment; the HTTP app and AI worker
# continue to run without Telegram getUpdates or deleteWebhook calls.
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_TOKEN=
# Required outside staging; must be unset when STAGING_MODE=true.
KOMMO_TOKEN=
OPENAI_API_KEY=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Required outside staging; not used in staging.
GH_TOKEN=
DATABASE_URL=
TENANT_ENCRYPTION_KEY=
KOMMO_OAUTH_CLIENT_ID=
KOMMO_OAUTH_CLIENT_SECRET=
KOMMO_OAUTH_REDIRECT_URI= # set to the exact callback on this deployment
CANONICAL_WEB_ORIGIN= # set to this deployment's HTTPS origin
AI_AGENTS_ENABLED=false
AI_AGENTS_TEST_WEBHOOK_ENABLED=false
AI_AGENTS_AUTO_SEND_ENABLED=false
AI_AGENTS_CRM_ENABLED=false
# The AI Agent uses the tenant-scoped Chat AI credential saved in /app. This
# global key is still required by the legacy application bootstrap.
OPENAI_MODEL=gpt-4o-mini-2024-07-18
LINEAR_API_KEY=

# Staging-only Test Mode allowlist. Blank values keep Test Mode blocked.
AI_AGENTS_TEST_CLIENT_PHONE=
AI_AGENTS_TEST_COMPANY_PHONE=
