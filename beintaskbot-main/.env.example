# Required in Railway. Keep values only in Railway Variables, never in Git.
TELEGRAM_TOKEN=
KOMMO_TOKEN=
OPENAI_API_KEY=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
GH_TOKEN=
DATABASE_URL=
TENANT_ENCRYPTION_KEY=
KOMMO_OAUTH_CLIENT_ID=
KOMMO_OAUTH_CLIENT_SECRET=
KOMMO_OAUTH_REDIRECT_URI=https://crm.pro.az/api/platform/integrations/kommo/callback
CANONICAL_WEB_ORIGIN=https://crm.pro.az
# Shared SSO client configuration for Connect.
CONNECT_SSO_REDIRECT_URI=https://connect.crm.pro.az/admin
CONNECT_SSO_CLIENT_SECRET=
AI_AGENTS_ENABLED=false
AI_AGENTS_TEST_WEBHOOK_ENABLED=false
AI_AGENTS_AUTO_SEND_ENABLED=false
# Scoped WhatsApp pilot is opt-in and remains off by default. These two
# recipients are the only permitted pilot destinations; never enable the
# company-wide auto-send flag for this pilot.
AI_AGENTS_PILOT_TENANT_ID=e09a5c24-093f-4141-992d-532052e00c90
AI_AGENTS_PILOT_CHANNEL_ID=96863d75-d272-4c93-a25e-ffb2b16ecae3
AI_AGENTS_PILOT_CONVERSATION_ID=994502072240@s.whatsapp.net
AI_AGENTS_PILOT_GROUP_CONVERSATION_ID=120363431915456655@g.us
AI_AGENTS_SCOPED_LIVE_ENABLED=false
AI_AGENTS_CRM_ENABLED=false
# The AI Agent uses the tenant-scoped Chat AI credential saved in /app. This
# global key is still required by the legacy application bootstrap.
OPENAI_MODEL=gpt-4o-mini-2024-07-18
LINEAR_API_KEY=

# Optional configuration
OPENAI_API_BASE=https://api.manus.im/api/llm-proxy/v1
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
