+/* Real Chromium, no browser automation dependency or HTTP interception.
+   Assertions execute as DOM events in the browser; not physical pointer tests. */
+const fs=require('node:fs'),{spawnSync}=require('node:child_process'),assert=require('node:assert/strict');
+const origin=process.env.AI_RUNTIME_ORIGIN,width=Number(process.env.AI_RUNTIME_WIDTH||1100);
+assert(/^http:\/\/127\.0\.0\.1:\d+$/.test(origin||''),'isolated localhost origin required');
+const executable=process.env.CHROMIUM_EXECUTABLE_PATH||'/usr/bin/chromium';
+assert(fs.existsSync(executable),'Chromium executable required');
+const userData=fs.mkdtempSync('/tmp/ai-chromium-');
+const run=spawnSync(executable,[`--user-data-dir=${userData}`,'--headless','--no-sandbox','--disable-gpu','--disable-dev-shm-usage','--no-proxy-server',
+ '--disable-background-networking','--disable-component-update','--disable-extensions','--no-first-run',
+ '--host-resolver-rules=MAP * ~NOTFOUND, EXCLUDE 127.0.0.1',`--window-size=${width},950`,
+ '--virtual-time-budget=20000','--dump-dom',origin+'/app'],{encoding:'utf8',timeout:65000,maxBuffer:4*1024*1024});
+fs.rmSync(userData,{recursive:true,force:true});
+const output=run.stdout||'',result=output.match(/<pre id="aiAcceptanceResult" data-result="([^"]+)">([\s\S]*?)<\/pre>/);
+assert(!run.error,run.error?.message);assert.equal(run.status,0,(run.stderr||'').slice(-2000));
+assert(result,'Browser acceptance did not run: '+(run.stderr||'').slice(-1000));
+assert.equal(result[1],'passed',result[2]);console.log(result[2]);
