+    monkeypatch.setenv('TENANT_SCOPED_ACCESS_ENABLED', 'true')
+    profile = {'tenant_id': tenant, 'telegram_id': actor, 'role': 'owner'}
+    for reader in [agents.list_handoffs, agents.list_connect_diagnostics, state.snapshot]:
