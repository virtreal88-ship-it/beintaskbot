+                WHERE tenant_id=%s::uuid AND id=%s::uuid AND archived_at IS NULL""",
+                (None if unlink else company, tenant_id, contact))
+        conn.commit()
+    return {'id': contact, 'company_id': company, 'linked': not unlink}
