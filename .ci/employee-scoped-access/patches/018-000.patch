+/* Isolated DOM integration tests: all fetches mocked; no credentials/provider I/O. */
+const assert=require('node:assert/strict'),fs=require('node:fs'),path=require('node:path');
+const {JSDOM}=require('jsdom');
+const source=name=>fs.readFileSync(path.join(__dirname,'../docs/',name),'utf8');
+const tick=()=>new Promise(resolve=>setTimeout(resolve,10));
+function harness(provider, actions, role='worker', linearSettings={}){
+ const dom=new JSDOM('<div id="view-settings"></div><div id="integrationSettingsHost"></div>',{url:'https://test.invalid',runScripts:'outside-only'}),w=dom.window;
+ const watchers=[], calls=[], confirmations=[];
+ w.tenantViewDemand={watch:item=>watchers.push(item),clean:()=>{}};
+ w.confirm=message=>{confirmations.push(message);return true;};
+ w.TenantLinearRules={render:()=>{},read:()=>({})};
+ w.fetch=async(url,options={})=>{calls.push({url,...options});return {ok:true,json:async()=>({success:true,updated_at:'v2',status:'connected',configured:true,channels:[],members:[],settings:linearSettings,teams:{nodes:[],pageInfo:{}}})};};
+ w.eval(source('tenant-shared-integration-settings.js'));
+ for(const file of ['tenant-kommo-settings.js','tenant-linear-settings.js','tenant-chat-ai-settings.js'])w.eval(source(file));
+ const data={member:{tenant_id:'tenant-a',telegram_id:42,role},integrations:[{provider:provider==='openai'?'chat_ai':provider,status:'connected',updated_at:'v1',...(actions?{management_actions:actions,status_only:!actions.view}:{})}]};
