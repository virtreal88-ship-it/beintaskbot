+ ui.profile(profile(true,false,false));await settle();assert.equal(requests.length,1);assert.equal(requests[0].url,'/api/platform/ai/agents');assert(document.getElementById('legacy').hidden);assert(!host().querySelector('[data-scoped-create]'));assert(![...host().querySelectorAll('button')].some(b=>b.textContent==='Edit'));
+ let releaseOptions;pending=new Promise(resolve=>releaseOptions=resolve);ui.profile(profile(false,true,false));await flush();assert(host().querySelector('[data-scoped-create]').disabled);host().querySelector('[data-scoped-create]').click();assert(!host().querySelector('form'));releaseOptions({ok:true,status:200,json:async()=>({success:true,result:options})});await settle();assert(!host().querySelector('[data-scoped-create]').disabled);
