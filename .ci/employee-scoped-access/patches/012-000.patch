+"""Shared tenant-scoped access rules, enabled only by explicit rollout.
+
+Callers must obtain current authenticated membership and tenant-bound resource
+metadata from the database, and revalidate within the mutation transaction.
+"""
+
+SCOPES = frozenset(('none', 'self', 'department', 'all'))
+
+
+def _id(value):
+    """Compare DB identity values without equating missing identities."""
+    if value is None or isinstance(value, bool):
+        return None
+    value = str(value).strip()
+    return value or None
+
+
+def _same(left, right):
+    left, right = _id(left), _id(right)
+    return left is not None and right is not None and left == right
+
+
+def _same_active_tenant(actor, resource):
+    return (actor.get('active') is True
+            and _same(actor.get('tenant_id'), resource.get('tenant_id'))
+            and _id(actor.get('member_id')) is not None)
+
+
+def allows_owned_resource(actor, resource, scope):
+    """Evaluate one independent action's scope against its responsible member.
+
+    The scope is supplied for the particular action by a trusted policy layer.
+    A department comparison requires both member and responsible member to have
+    a known department. The resource's department must be resolved from the
+    responsible member's current membership within the same tenant. This helper
+    intentionally does not define creation, assignment, or migration semantics.
+    """
+    if scope not in SCOPES or not _same_active_tenant(actor, resource):
+        return False
+    if scope == 'all':
+        return True
+    if scope == 'self':
+        return _same(actor.get('member_id'), resource.get('responsible_member_id'))
+    if scope == 'department':
+        return (_id(resource.get('responsible_member_id')) is not None
+                and _same(actor.get('department_id'), resource.get('responsible_department_id')))
+    return False
+
+
+def allows_assigned_task_exception(actor, task, operation):
+    """Allow only reading or completion of an explicitly assigned task.
+
+    This does not authorize a general task update. A completion endpoint must
+    separately restrict its payload and validate the state transition.
+    """
+    return (operation in ('read', 'complete')
+            and _same_active_tenant(actor, task)
+            and _same(actor.get('member_id'), task.get('assignee_member_id')))
+
+# A rollout gate keeps additive schema changes from changing existing authority.
+# It is read for every evaluation, including long-lived worker processes.
+def scoped_access_enabled():
+    import os
+    return os.environ.get('TENANT_SCOPED_ACCESS_ENABLED', '').strip().lower() in {'1', 'true', 'yes'}
+
+
+CRUD_ACTIONS = ('view', 'create', 'update', 'delete')
+# Only sections with resource-aware API implementations belong in this catalog.
+# Other sections retain their existing domain-specific checks.
+SCOPE_ACTION_CATALOG = {key: CRUD_ACTIONS for key in
+                        ('tasks', 'deals', 'customers', 'companies')}
+SCOPE_ACTION_CATALOG['dialogs'] = ('view', 'update')
+SCOPE_ACTION_CATALOG['finance'] = ('view',)
+# Agent document actions only; deletion/shared AI administration stay separate.
+SCOPE_ACTION_CATALOG['ai_agents'] = ('view', 'create', 'update')
+# Shared connection settings are owner-responsible; status is a separate public read.
+SCOPE_ACTION_CATALOG['integrations'] = CRUD_ACTIONS
+SCOPE_ACTION_CATALOG['employees'] = ('view', 'update')
+SCOPE_ACTION_CATALOG['support'] = ('view', 'create', 'update')
+ACTIVE_TENANT_STATUSES = frozenset({'active', 'onboarding', 'ready_for_integration'})
+MODULE_ALIASES = {'contacts': 'customers'}
+
+
+def canonical_module(module):
+    return MODULE_ALIASES.get(module, module)
+
+
+def validate_access_scopes(value):
+    if not isinstance(value, dict) or set(value) - set(SCOPE_ACTION_CATALOG):
+        raise ValueError('member_access_scopes_invalid')
+    for module, actions in value.items():
+        if (not isinstance(actions, dict) or not actions
+                or set(actions) - set(SCOPE_ACTION_CATALOG[module])
+                or any(not isinstance(scope, str) or scope not in SCOPES for scope in actions.values())):
+            raise ValueError('member_access_scopes_invalid')
+
+
+def configured_action_scope(policy, module, action):
+    """Return None only for an absent override; malformed configured data denies.
+
+    A legacy grant is deliberately not converted into `all`: legacy providers
+    may have more restrictive pipeline/marker or role checks.
+    """
+    if not scoped_access_enabled():
+        return None
+    module = canonical_module(module)
+    if module not in SCOPE_ACTION_CATALOG or action not in SCOPE_ACTION_CATALOG[module]:
+        return None
+    settings = policy.member_settings
+    if 'access_scopes' not in settings:
+        return None
+    scopes = settings['access_scopes']
+    if not isinstance(scopes, dict):
+        return 'none'
+    if module not in scopes:
+        return None
+    actions = scopes[module]
+    if not isinstance(actions, dict):
+        return 'none'
+    if action not in actions:
+        return None
+    scope = actions[action]
+    return scope if isinstance(scope, str) and scope in SCOPES else 'none'
+
+
+def profile_actor(profile):
+    return {'tenant_id': profile.get('tenant_id'),
+            'member_id': profile.get('telegram_id'),
+            'department_id': profile.get('department_id'),
+            'active': (profile.get('active') is not False
+                       and profile.get('tenant_status', 'active') in ACTIVE_TENANT_STATUSES)}
+
+
+def resource_metadata(resource):
+    return {**resource,
+            'responsible_member_id': resource.get('responsible_member_id', resource.get('access_responsible_id'))}
+
+
+def preserve_workflow_access_scopes(previous, incoming):
+    """Old workflow forms cannot reset or bypass versioned employee rights.
+
+    Echoing the exact setting is accepted; omitting it retains it. Only the
+    employee-card writer can actually change a matrix, including its preflight.
+    """
+    previous = previous if isinstance(previous, dict) else {}
+    if not isinstance(incoming, dict):
+        raise ValueError('member_access_requires_employee_editor')
+    result = {key: dict(value) if isinstance(value, dict) else value for key, value in incoming.items()}
+    absent = object()
+    for key in set(previous) | set(result):
+        old = previous.get(key, {})
+        new = result.get(key, {})
+        if not isinstance(old, dict) or not isinstance(new, dict):
+            raise ValueError('member_access_requires_employee_editor')
+        old_scope = old.get('access_scopes', absent)
+        new_scope = new.get('access_scopes', absent)
+        if new_scope is not absent and new_scope != old_scope:
+            raise ValueError('member_access_requires_employee_editor')
+        if old_scope is not absent:
+            result.setdefault(key, {})['access_scopes'] = old_scope
+    return result
diff --git a/beintaskbot-main/tenant_scoped_access_schema.py b/beintaskbot-main/tenant_scoped_access_schema.py
new file mode 100644
index 0000000000000000000000000000000000000000..07f4ceb312835281ef4bfb73f759462ce89c4317
--- /dev/null
+++ b/beintaskbot-main/tenant_scoped_access_schema.py
@@ -0,0 +1,97 @@
+"""Additive scoped-access schema and one-time, auditable historical ownership.
+
+No membership grants or existing responsible/assignee values are rewritten.
+Unambiguous historical documents are assigned to the company's sole active
+owner. Missing or conflicting owners leave documents unowned and record issues.
+A durable per-table marker prevents later system-created NULL documents from
+being accidentally treated as historical records on another startup.
+"""
+
+RESOURCE_TABLES = ('saas_crm_native_contacts', 'saas_crm_native_companies',
+                   'saas_crm_native_deals', 'saas_crm_native_tasks')
+
+
+def migrate_department_schema(cur):
+    cur.execute('''CREATE TABLE IF NOT EXISTS saas_tenant_departments (
+        tenant_id UUID NOT NULL REFERENCES saas_tenants(id) ON DELETE CASCADE,
+        id UUID NOT NULL,
+        name TEXT NOT NULL CHECK(length(trim(name)) BETWEEN 1 AND 120),
+        active BOOLEAN NOT NULL DEFAULT TRUE,
+        created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
+        updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
+        PRIMARY KEY(tenant_id,id)
+    )''')
+    cur.execute('''CREATE UNIQUE INDEX IF NOT EXISTS saas_tenant_departments_name_idx
+        ON saas_tenant_departments(tenant_id,lower(trim(name))) WHERE active''')
+    cur.execute('ALTER TABLE saas_tenant_members ADD COLUMN IF NOT EXISTS department_id UUID NULL')
+    cur.execute('''DO $$ BEGIN
+        IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname='saas_tenant_member_department_fk'
+            AND conrelid='saas_tenant_members'::regclass) THEN
+            ALTER TABLE saas_tenant_members ADD CONSTRAINT saas_tenant_member_department_fk
+                FOREIGN KEY(tenant_id,department_id) REFERENCES saas_tenant_departments(tenant_id,id);
+        END IF;
+    END $$''')
+    cur.execute('''CREATE INDEX IF NOT EXISTS saas_tenant_member_department_idx
+        ON saas_tenant_members(tenant_id,department_id,telegram_id)''')
+
+
+def migrate_scoped_access_schema(cur):
+    # Shared transaction/advisory lock covers concurrent startup callers too.
+    cur.execute("SELECT pg_advisory_xact_lock(hashtextextended('tenant-scoped-access-schema',0))")
+    migrate_department_schema(cur)
+    migrate_resource_ownership(cur, RESOURCE_TABLES)
+    from tenant_dialog_access import migrate_dialog_access_schema
+    migrate_dialog_access_schema(cur)
+
+
+def migrate_resource_ownership(cur, tables):
+    """Install ownership for an explicit, code-owned resource table allowlist."""
+    if not set(tables) <= set(RESOURCE_TABLES) | {'saas_ai_agents', 'saas_support_tickets'}:
+        raise ValueError('unsupported_scoped_ownership_table')
+    cur.execute("SELECT pg_advisory_xact_lock(hashtextextended('tenant-scoped-access-schema',0))")
+    cur.execute('''CREATE TABLE IF NOT EXISTS saas_access_schema_migrations (
+        migration_key TEXT PRIMARY KEY, applied_at TIMESTAMPTZ NOT NULL DEFAULT now()
+    )''')
+    cur.execute('''CREATE TABLE IF NOT EXISTS saas_access_migration_issues (
+        tenant_id UUID NOT NULL REFERENCES saas_tenants(id) ON DELETE CASCADE,
+        resource_table TEXT NOT NULL,
+        resource_id TEXT NOT NULL,
+        reason TEXT NOT NULL,
+        created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
+        PRIMARY KEY(tenant_id,resource_table,resource_id)
+    )''')
+    for table in tables:
+        cur.execute('SELECT to_regclass(%s) AS relation', (table,))
+        if not (cur.fetchone() or {}).get('relation'):
+            continue
+        cur.execute(f'ALTER TABLE {table} ADD COLUMN IF NOT EXISTS access_responsible_id BIGINT NULL')
+        constraint = table + '_access_owner_fk'
+        cur.execute('SELECT 1 FROM pg_constraint WHERE conname=%s AND conrelid=%s::regclass', (constraint, table))
+        if not cur.fetchone():
+            cur.execute(f'''ALTER TABLE {table} ADD CONSTRAINT {constraint}
+                FOREIGN KEY(tenant_id,access_responsible_id)
+                REFERENCES saas_tenant_members(tenant_id,telegram_id)''')
+        cur.execute(f'''CREATE INDEX IF NOT EXISTS {table}_access_owner_idx
+            ON {table}(tenant_id,access_responsible_id)''')
+        key = 'historical-access-owner-v1:' + table
+        cur.execute('SELECT 1 FROM saas_access_schema_migrations WHERE migration_key=%s', (key,))
+        if cur.fetchone():
+            continue
+        # Lock writes while taking the historical snapshot. Running this once
+        # before serving new code prevents old/new semantics from overlapping.
+        cur.execute(f'LOCK TABLE {table} IN SHARE ROW EXCLUSIVE MODE')
+        cur.execute(f'''WITH owners AS (
+            SELECT t.id AS tenant_id, t.owner_telegram_id
+            FROM saas_tenants t JOIN saas_tenant_members m ON m.tenant_id=t.id
+            WHERE m.role='owner'
+            GROUP BY t.id,t.owner_telegram_id
+            HAVING count(*)=1 AND bool_and(m.active)
+              AND min(m.telegram_id)=t.owner_telegram_id
+        ) UPDATE {table} r SET access_responsible_id=o.owner_telegram_id
+          FROM owners o WHERE r.tenant_id=o.tenant_id AND r.access_responsible_id IS NULL''')
+        cur.execute(f'''INSERT INTO saas_access_migration_issues
+            (tenant_id,resource_table,resource_id,reason)
+            SELECT tenant_id,%s,id::text,'sole_active_company_owner_required'
+            FROM {table} WHERE access_responsible_id IS NULL
+            ON CONFLICT DO NOTHING''', (table,))
+        cur.execute('INSERT INTO saas_access_schema_migrations(migration_key) VALUES(%s)', (key,))
diff --git a/beintaskbot-main/tenant_scoped_access_store.py b/beintaskbot-main/tenant_scoped_access_store.py
new file mode 100644
index 0000000000000000000000000000000000000000..76ce58136698be50518d447edf864d477633af97
--- /dev/null
+++ b/beintaskbot-main/tenant_scoped_access_store.py
@@ -0,0 +1,92 @@
+"""Tenant-bound, transaction-friendly primitives for scoped API implementations.
+
+These helpers never commit and never repair schema on a request. Callers retain
+legacy provider restrictions when action_scope is None, and must use the same
+transaction for the authorization check and the requested operation.
+"""
+import re
+
+from tenant_policy import TenantPolicy
+from tenant_scoped_access import ACTIVE_TENANT_STATUSES, canonical_module
+
+
+def read_access_profile(cur, tenant_id, actor_id, lock=False):
+    suffix = ' FOR SHARE' if lock else ''
+    cur.execute('SELECT id,modules,status,owner_telegram_id,onboarding FROM saas_tenants WHERE id=%s::uuid' + suffix,
+                (str(tenant_id),))
+    company = cur.fetchone()
+    if not company or company.get('status') not in ACTIVE_TENANT_STATUSES:
+        return None
+    if lock:
+        cur.execute('''SELECT policy_key FROM saas_tenant_workflow_policies
+            WHERE tenant_id=%s::uuid AND policy_key=ANY(%s::text[])
+            ORDER BY policy_key FOR SHARE''', (str(tenant_id), ['members', 'modules']))
+        cur.fetchall()
+    cur.execute('''SELECT * FROM saas_tenant_members
+        WHERE tenant_id=%s::uuid AND telegram_id=%s''' + suffix, (str(tenant_id), int(actor_id)))
+    row = cur.fetchone()
+    if not row or row.get('active') is not True:
+        return None
+    from tenant_workflow_store import _read_tenant_workflow
+    return {**dict(row), 'modules': company.get('modules') or {},
+            'tenant_status': company['status'], 'company_owner_id': company['owner_telegram_id'],
+            'onboarding': company.get('onboarding') or {},
+            'workflow': _read_tenant_workflow(cur, str(tenant_id))}
+
+
+def _column(alias, column):
+    if not re.fullmatch(r'[A-Za-z_][A-Za-z_0-9]*', alias) or not re.fullmatch(r'[A-Za-z_][A-Za-z_0-9]*', column):
+        raise ValueError('invalid_scope_sql_identifier')
+    return f'{alias}.{column}'
+
+
+def resource_scope_sql(profile, module, action, alias='r', responsible_column='access_responsible_id'):
+    """Return a parameterized predicate; always include the tenant boundary.
+
+    For a missing scope, this tests the legacy CRUD grant but does not replace
+    legacy pipeline, provider or assigned-task policies at the call site.
+    """
+    tenant = _column(alias, 'tenant_id')
+    responsible = _column(alias, responsible_column)
+    if not profile or profile.get('active') is False or profile.get('tenant_status', 'active') not in ACTIVE_TENANT_STATUSES:
+        return 'FALSE', []
+    if not profile.get('tenant_id') or not profile.get('telegram_id'):
+        return 'FALSE', []
+    module = canonical_module(module)
+    policy = TenantPolicy(profile)
+    scope = policy.action_scope(module, action)
+    legacy_module = 'customers' if module == 'companies' else module
+    if scope is None:
+        if not policy.legacy_allows_action(legacy_module, action):
+            return 'FALSE', []
+        return f'{tenant}=%s::uuid', [str(profile['tenant_id'])]
+    if scope == 'none':
+        return 'FALSE', []
+    params = [str(profile['tenant_id'])]
+    if scope == 'all':
+        return f'{tenant}=%s::uuid', params
+    if scope == 'self':
+        return f'({tenant}=%s::uuid AND {responsible}=%s)', params + [int(profile['telegram_id'])]
+    if scope == 'department' and profile.get('department_id'):
+        return (f'''({tenant}=%s::uuid AND EXISTS (
+            SELECT 1 FROM saas_tenant_members scope_member
+            WHERE scope_member.tenant_id={tenant}
+              AND scope_member.telegram_id={responsible}
+              AND scope_member.department_id=%s::uuid))''', params + [str(profile['department_id'])])
+    return 'FALSE', []
+
+
+def owned_resource_metadata(cur, tenant_id, row, *, lock=False, responsible_column='access_responsible_id'):
+    """Resolve current responsible department in this tenant, never from payload."""
+    resource = dict(row)
+    resource['responsible_member_id'] = row.get(responsible_column)
+    resource['responsible_department_id'] = None
+    if str(row.get('tenant_id')) != str(tenant_id) or row.get(responsible_column) is None:
+        return resource
+    cur.execute('''SELECT department_id FROM saas_tenant_members
+        WHERE tenant_id=%s::uuid AND telegram_id=%s''' + (' FOR SHARE' if lock else ''),
+                (str(tenant_id), row[responsible_column]))
+    member = cur.fetchone()
+    if member:
+        resource['responsible_department_id'] = member.get('department_id')
+    return resource
diff --git a/beintaskbot-main/tenant_shared_integration_access.py b/beintaskbot-main/tenant_shared_integration_access.py
new file mode 100644
index 0000000000000000000000000000000000000000..fa63b136752a7e462c009ef9f2fca9496769914e
--- /dev/null
+++ b/beintaskbot-main/tenant_shared_integration_access.py
@@ -0,0 +1,223 @@
+"""Current-DB CRUD scopes for company-wide integrations.
+
+The responsible member is the unique active company owner, never the caller.
+Provider-specific guards remain inside the operation. Credentials are never
+returned here. Callers must wrap the complete operation, including provider I/O.
+"""
+from contextlib import contextmanager
+from contextvars import ContextVar
+from functools import wraps
+import inspect
+
+from tenant_linear_policy import TenantLinearError, identifier
+from tenant_policy import TenantPolicy
+from tenant_scoped_access import allows_owned_resource, profile_actor, scoped_access_enabled
+from tenant_scoped_access_store import read_access_profile
+
+_ADMISSION = ContextVar('shared_integration_admission', default=None)
+PROVIDERS = frozenset({'kommo', 'kommo_manual', 'beinsystems', 'linear', 'connect', 'chat_ai'})
+LEGACY_ROLES = {'connect': {'owner', 'admin'}, 'chat_ai': {'owner', 'admin'}}
+
+
+def principal(profile):
+    if not isinstance(profile, dict):
+        raise TenantLinearError('integration_access_denied', 403)
+    tenant = identifier(profile.get('tenant_id'))
+    try:
+        if isinstance(profile.get('telegram_id'), bool): raise ValueError()
+        actor = int(profile.get('telegram_id'))
+    except (ValueError, TypeError):
+        raise TenantLinearError('integration_access_denied', 403) from None
+    if actor <= 0:
+        raise TenantLinearError('integration_access_denied', 403)
+    return tenant, actor
+
+
+def admitted(profile, provider):
+    value = _ADMISSION.get()
+    return bool(value and isinstance(profile, dict) and value[:2] == principal(profile) and value[2] == provider)
+
+
+def current_role(profile, provider):
+    value = _ADMISSION.get()
+    return value[4] if admitted(profile, provider) else None
+
+
+def owner_resource(cur, current):
+    """Ambiguous owner records do not become self/department grants."""
+    tenant = str(current['tenant_id'])
+    cur.execute("SELECT telegram_id,department_id,active FROM saas_tenant_members WHERE tenant_id=%s::uuid AND role='owner' AND active=TRUE ORDER BY telegram_id FOR SHARE", (tenant,))
+    rows = cur.fetchall()
+    owner = rows[0] if len(rows) == 1 else None
+    valid = bool(owner and owner.get('active') is True
+                 and str(owner['telegram_id']) == str(current.get('company_owner_id')))
+    return {'tenant_id': tenant,
+            'responsible_member_id': owner['telegram_id'] if valid else None,
+            'responsible_department_id': owner.get('department_id') if valid else None}
+
+
+def allowed(current, resource, provider, action):
+    if action not in {'view', 'create', 'update', 'delete'} or provider not in PROVIDERS:
+        return False
+    if current.get('active') is not True or current.get('tenant_status') != 'active':
+        return False
+    if current.get('role') == 'owner':
+        return True
+    scope = TenantPolicy(current).action_scope('integrations', action)
+    if scope is None:
+        return current.get('role') in LEGACY_ROLES.get(provider, {'owner'})
+    return allows_owned_resource(profile_actor(current), resource, scope)
+
+
+def capabilities(cur, current, provider):
+    resource = owner_resource(cur, current)
+    return {action: allowed(current, resource, provider, action)
+            for action in ('view', 'create', 'update', 'delete')}
+
+
+
+def _action(cur, tenant, provider, action):
+    if action != 'connect': return action
+    cur.execute("SELECT 1 FROM saas_tenant_integrations WHERE tenant_id=%s::uuid AND provider=ANY(%s::text[]) AND (secrets IS NOT NULL OR status IN ('connected','configured','awaiting_oauth'))", (tenant, ['kommo','kommo_manual'] if provider in {'kommo','kommo_manual'} else [provider]))
+    if cur.fetchone(): return 'update'
+    if provider == 'connect':
+        cur.execute('SELECT 1 FROM saas_connect_channels WHERE tenant_id=%s::uuid LIMIT 1', (tenant,))
+        if cur.fetchone(): return 'update'
+    return 'create'
+
+
+def _context(tenant, actor, action, connecting, data):
+    if action == 'view': return
+    if not isinstance(data, dict) or str(data.get('expected_tenant_id')) != tenant or str(data.get('expected_user_id')) != str(actor):
+        raise TenantLinearError('integration_context_changed', 409)
+    impact = action == 'delete' or (action == 'update' and (connecting or any(data.get(k) for k in ('api_key','access_token','token','remove_key'))))
+    if impact and data.get('confirm_company_impact') is not True:
+        raise TenantLinearError('integration_company_impact_confirmation_required',409)
+
+
+def mutation_receipt(result, provider):
+    """No previous settings/channel/employee projection through a write grant."""
+    if isinstance(result, tuple) and len(result) == 2:
+        return ({}, mutation_receipt(result[1], provider))  # manual Kommo account/connection
+    result = result if isinstance(result, dict) else {}
+    return {'provider': provider, **{key: result[key] for key in
+        ('status','updated_at','connected','configured') if key in result}}
+
+@contextmanager
+def guard(factory, profile, provider, action, *, data=None, required_actions=(), legacy_member_read=False):
+    """Hold current member/department/policy fences across a scoped operation.
+
+    No override means the exact old provider guard remains authoritative. The
+    context marker is internal and bound to actor, tenant and provider; a caller
+    cannot manufacture it using role fields or JSON.
+    """
+    if not scoped_access_enabled():
+        yield
+        return
+    existing = _ADMISSION.get()
+    if existing:
+        if not admitted(profile, provider):
+            raise TenantLinearError('integration_nested_operation_denied',403)
+        nested_action = _action(existing[7], existing[0], provider, action)
+        if nested_action != existing[3] or not all(allowed(existing[5],existing[6],provider,item) for item in required_actions):
+            raise TenantLinearError('integration_nested_operation_denied',403)
+        _context(existing[0],existing[1],nested_action,action == 'connect',data)
+        yield
+        return
+    tenant, actor = principal(profile)
+    with factory() as conn:
+        with conn.cursor() as cur:
+            current = read_access_profile(cur, tenant, actor, lock=True)
+            if not current:
+                raise TenantLinearError('integration_access_denied', 403)
+            policy = TenantPolicy(current)
+            explicit = policy.has_scoped_access('integrations')
+            if not explicit and current.get('tenant_status') != 'active':
+                # Release these new locks before old onboarding operations,
+                # whose own provider-specific transaction model is unchanged.
+                conn.commit()
+                yield
+                return
+            if provider not in PROVIDERS:
+                if explicit: raise TenantLinearError('integration_operation_not_scoped',403)
+                conn.commit()
+                yield
+                return
+            cur.execute('SELECT pg_advisory_xact_lock(hashtextextended(%s,0))', ('shared-integration:'+tenant+':'+('kommo' if provider=='kommo_manual' else provider),))
+            connecting = action == 'connect'
+            action = _action(cur, tenant, provider, action)
+            resource = owner_resource(cur, current)
+            legacy_status = (legacy_member_read and action == 'view'
+                             and policy.action_scope('integrations', 'view') is None)
+            if not ((legacy_status or allowed(current, resource, provider, action))
+                    and all(allowed(current, resource, provider, item) for item in required_actions)):
+                raise TenantLinearError('integration_action_denied', 403)
+            _context(tenant,actor,action,connecting,data)
+            token = _ADMISSION.set((tenant, actor, provider, action, current['role'], current, resource, cur))
+            try:
+                yield
+            finally:
+                _ADMISSION.reset(token)
+
+
+def operation(provider, action, *, data_arg=None, required_actions=(), legacy_member_read=False):
+    """Decorate an existing synchronous provider service, never a background job."""
+    def decorate(function):
+        signature = inspect.signature(function)
+        @wraps(function)
+        def run(*args, **kwargs):
+            if not scoped_access_enabled():
+                return function(*args, **kwargs)
+            bound = signature.bind(*args, **kwargs)
+            bound.apply_defaults()
+            values = bound.arguments
+            profile = values.get('profile', values.get('session'))
+            if profile is None:
+                profile = {'tenant_id': values['tenant_id'], 'telegram_id': values['owner_id']}
+            actual_provider = provider(values) if callable(provider) else provider
+            actual_action = action(values) if callable(action) else action
+            data = values.get(data_arg) if data_arg else None
+            additional = required_actions(values) if callable(required_actions) else required_actions
+            # Initialize schema before holding member/company row fences. Legacy
+            # service initializers can commit or acquire DDL locks.
+            if scoped_access_enabled() and _ADMISSION.get() is None:
+                initializer = next((function.__globals__.get(name) for name in
+                    ('_schema', 'ensure_schema', '_ensure_schema') if callable(function.__globals__.get(name))), None)
+                if initializer:
+                    with function.__globals__['_connect']() as conn:
+                        initializer(conn)
+                        conn.commit()
+            with guard(function.__globals__['_connect'], profile, actual_provider, actual_action, data=data, required_actions=additional, legacy_member_read=legacy_member_read):
+                result = function(*args, **kwargs)
+                admission = _ADMISSION.get()
+                if admission and admission[3] != 'view' and not allowed(admission[5],admission[6],actual_provider,'view'):
+                    return mutation_receipt(result, actual_provider)
+                return result
+        return run
+    return decorate
+
+
+def safe_status(row):
+    """Public connection state, never an arbitrary metadata/settings projection."""
+    row = row or {}
+    return {'provider': str(row.get('provider') or ''),
+            'status': str(row.get('status') or 'not_connected'),
+            'connected_at': str(row.get('connected_at') or '') or None,
+            'updated_at': str(row.get('updated_at') or '') or None}
+
+
+def project_status(cur, current, rows):
+    """Scope-aware bootstrap projection; non-managers see only connection state."""
+    resource = owner_resource(cur, current)
+    by_provider = {row['provider']: row for row in rows}
+    for provider in sorted(PROVIDERS - {'kommo_manual'}):
+        by_provider.setdefault(provider, {'provider': provider, 'status': 'not_connected'})
+    result = []
+    for provider, row in by_provider.items():
+        actions = {action: allowed(current, resource, provider, action)
+                   for action in ('view', 'create', 'update', 'delete')}
+        # Even managers never receive arbitrary metadata from bootstrap. Each
+        # provider's guarded settings endpoint owns its explicit safe projection.
+        result.append({**safe_status(row), 'management_actions': actions,
+                       'status_only': not actions['view']})
+    return sorted(result, key=lambda row: row['provider'])
