diff --git a/beintaskbot-main/tenant_crm_relation_store.py b/beintaskbot-main/tenant_crm_relation_store.py
new file mode 100644
index 0000000000000000000000000000000000000000..0e9d4286e651d3cc9a6f8905ec188c6d48ced3a9
--- /dev/null
+++ b/beintaskbot-main/tenant_crm_relation_store.py
@@ -0,0 +1,134 @@
+"""Dormant transactional relationship journal. No routes or workers call it.
+
+All primitives use the caller's transaction. No legacy external ID is adopted,
+no whole-record sync event is created, and no permission is inferred from a
+queued intent. The existing request-time 409 gate intentionally remains.
+"""
+import json
+import uuid
+
+from tenant_crm_native_access import CRMAccessError, current_access, locked_resource
+from tenant_crm_relation_contract import RecordRef, RelationIntent
+from tenant_crm_relation_identity import current_binding, read_identity
+
+ENTITIES = {
+    'deal': ('deals', 'saas_crm_native_deals'),
+    'contact': ('customers', 'saas_crm_native_contacts'),
+    'company': ('companies', 'saas_crm_native_companies'),
+}
+RELATIONS = {'deal_contact': ('deal', 'contact_id', 'contact'),
+             'contact_company': ('contact', 'company_id', 'company')}
+
+
+def _lock_resources(cur, tenant, actor, source, records):
+    # Tenant key lock also fences insertion of a newly preferred integration
+    # (a missing OAuth row cannot be protected by locking existing rows only).
+    cur.execute('SELECT id FROM saas_tenants WHERE id=%s::uuid FOR UPDATE', (tenant,))
+    if not cur.fetchone():
+        raise CRMAccessError('relation_resource_unavailable')
+    module, _ = ENTITIES[source.entity_type]
+    if type(actor) is not int or actor <= 0:
+        raise CRMAccessError('relation_human_actor_required')
+    profile = current_access(cur, tenant, actor, module, 'update')
+    rows = {}
+    # Same ordering for forward and reverse-card operations.
+    for ref in sorted(set(records) | {source}, key=lambda ref: (ref.entity_type, ref.internal_id)):
+        resource_module, table = ENTITIES[ref.entity_type]
+        if ref == source:
+            row = locked_resource(cur, profile, resource_module, 'update', table, tenant, ref.internal_id)
+        else:
+            cur.execute(f'''SELECT * FROM {table} WHERE tenant_id=%s::uuid
+              AND id=%s::uuid AND archived_at IS NULL FOR UPDATE''', (tenant, ref.internal_id))
+            row = cur.fetchone()
+        if not row:
+            raise CRMAccessError('relation_resource_unavailable')
+        rows[ref] = row
+    return rows
+
+
+def _settings(cur, binding, relation):
+    entity, field, _ = RELATIONS[relation]
+    cur.execute('''SELECT provider,sync_direction,allowed_fields FROM saas_crm_provider_settings
+      WHERE tenant_id=%s::uuid AND entity_type=%s FOR SHARE''', (binding.tenant_id, entity))
+    row = cur.fetchone() or {}
+    if (row.get('provider') != binding.provider
+            or row.get('sync_direction') not in ('to_external', 'bidirectional')
+            or field not in (row.get('allowed_fields') or [])):
+        raise CRMAccessError('relation_sync_disabled', 409)
+
+
+def _identities(cur, intent):
+    if current_binding(cur, intent.changed.binding.tenant_id) != intent.changed.binding:
+        raise CRMAccessError('relation_connection_changed', 409)
+    for identity in (intent.changed, intent.before, intent.after):
+        if identity and read_identity(cur, identity.binding, identity.record) != identity:
+            raise CRMAccessError('relation_identity_changed', 409)
+    _settings(cur, intent.changed.binding, intent.relation)
+
+
+def change_relation(cur, *, tenant, actor, source, changed, relation, before, after,
+                    expected_revision, expectation, event_id=None):
+    """Atomic local FK change + journal; caller commits or rolls back BOTH.
+
+    Expected provider digest comes from a binding-verified complete observation.
+    This is not a public API and does not enable outbound delivery.
+    """
+    kind, column, target_kind = RELATIONS[relation]
+    if changed.entity_type != kind or any(ref and ref.entity_type != target_kind for ref in (before, after)):
+        raise CRMAccessError('invalid_relation', 409)
+    records = [ref for ref in (changed, before, after) if ref]
+    rows = _lock_resources(cur, tenant, actor, source, records)
+    previous = rows[changed]
+    if (previous['updated_at'] != expected_revision
+            or str(previous.get(column) or '') != (before.internal_id if before else '')):
+        raise CRMAccessError('relation_local_conflict', 409)
+    binding = current_binding(cur, tenant)
+    if not binding:
+        raise CRMAccessError('relation_connection_unavailable', 409)
+    refs = {ref: read_identity(cur, binding, ref) for ref in records}
+    # Validate source semantics before any mutation.
+    ident = event_id or str(uuid.uuid4())
+    intent = RelationIntent(ident, actor, source, relation, refs[changed],
+        refs.get(before), refs.get(after), expected_revision, expectation)
+    _settings(cur, binding, relation)
+    table = ENTITIES[kind][1]
+    cur.execute(f'''UPDATE {table} SET {column}=%s::uuid,updated_at=clock_timestamp()
+      WHERE tenant_id=%s::uuid AND id=%s::uuid RETURNING updated_at''',
+      (after.internal_id if after else None, tenant, changed.internal_id))
+    revision = cur.fetchone()['updated_at']
+    intent = RelationIntent(ident, actor, source, relation, refs[changed],
+        refs.get(before), refs.get(after), revision, expectation)
+    cur.execute('''INSERT INTO saas_crm_relation_outbox
+      (id,tenant_id,changed_type,changed_id,relation,intent,intent_hash)
+      VALUES(%s::uuid,%s::uuid,%s,%s::uuid,%s,%s::jsonb,%s)''',
+      (ident, tenant, kind, changed.internal_id, relation, json.dumps(intent.to_payload()), intent.fingerprint()))
+    cur.execute('''INSERT INTO saas_crm_relation_heads(tenant_id,changed_type,changed_id,relation,event_id)
+      VALUES(%s::uuid,%s,%s::uuid,%s,%s::uuid)
+      ON CONFLICT(tenant_id,changed_type,changed_id,relation)
+      DO UPDATE SET event_id=EXCLUDED.event_id''', (tenant, kind, changed.internal_id, relation, ident))
+    return intent
+
+
+def reauthorize(cur, row):
+    """Locks source U, graph, identity, connection and policy until I/O ends."""
+    intent = RelationIntent.from_payload(row['intent'])
+    tenant = intent.changed.binding.tenant_id
+    if (intent.fingerprint() != row['intent_hash'] or str(row['id']) != intent.event_id
+            or str(row['tenant_id']) != tenant or row['relation'] != intent.relation
+            or row['changed_type'] != intent.changed.record.entity_type
+            or str(row['changed_id']) != intent.changed.record.internal_id):
+        raise CRMAccessError('relation_event_changed', 409)
+    records = [ref.record for ref in (intent.changed, intent.before, intent.after) if ref]
+    rows = _lock_resources(cur, tenant, intent.actor_id, intent.source, records)
+    _identities(cur, intent)
+    cur.execute('''SELECT event_id FROM saas_crm_relation_heads WHERE tenant_id=%s::uuid
+      AND changed_type=%s AND changed_id=%s::uuid AND relation=%s FOR SHARE''',
+      (tenant, intent.changed.record.entity_type, intent.changed.record.internal_id, intent.relation))
+    head = cur.fetchone()
+    current = rows[intent.changed.record]
+    column = RELATIONS[intent.relation][1]
+    if (not head or str(head['event_id']) != intent.event_id
+            or current['updated_at'] != intent.local_revision
+            or str(current.get(column) or '') != (intent.after.record.internal_id if intent.after else '')):
+        raise CRMAccessError('relation_superseded', 409)
+    return intent
diff --git a/beintaskbot-main/tenant_crm_scalar_delivery.py b/beintaskbot-main/tenant_crm_scalar_delivery.py
new file mode 100644
index 0000000000000000000000000000000000000000..8e6f346144e5726068d462ea9e382a110fed585e
--- /dev/null
+++ b/beintaskbot-main/tenant_crm_scalar_delivery.py
@@ -0,0 +1,136 @@
+"""One-shot scalar PATCH with immutable provenance and current access fences.
+
+No relation body, implicit create, automatic retry, token refresh, or rebinding.
+Provider scalar PATCH is not remote CAS; known divergent scalar values conflict.
+"""
+import asyncio
+from tenant_crm_native_access import CRMAccessError
+from tenant_crm_scalar_store import reauthorize, lock_admission
+
+
+def _remote_values(event, remote):
+    if not isinstance(remote,dict) or str(remote.get('id')) != event['external_id']:
+        raise CRMAccessError('scalar_remote_identity_mismatch')
+    values={}
+    for field in event['field_mask']:
+        if field in ('title','name'):
+            value=remote.get('name')
+            if not isinstance(value,str): raise CRMAccessError('scalar_remote_field_unknown')
+            values[field]=value
+        elif field in ('phone','email'):
+            fields=remote.get('custom_fields_values')
+            if fields is None: fields=[]
+            if not isinstance(fields,list) or any(not isinstance(item,dict) for item in fields):
+                raise CRMAccessError('scalar_remote_field_unknown')
+            matches=[item for item in fields if item.get('field_code')==field.upper()]
+            if len(matches)>1: raise CRMAccessError('scalar_remote_multivalue')
+            items=(matches[0].get('values') or []) if matches else []
+            if not isinstance(items,list) or len(items)>1 or any(not isinstance(item,dict) or not isinstance(item.get('value'),str) for item in items):
+                raise CRMAccessError('scalar_remote_multivalue')
+            values[field]=items[0]['value'] if items else ''
+        else:
+            raise CRMAccessError('scalar_field_contract_unverified')
+    return values
+
+
+def body(event, remote):
+    result={}
+    for field,value in event['values'].items():
+        if field in ('title','name'): result['name']=value
+        elif field in ('phone','email') and value:
+            item={'value':value}
+            # Preserve the existing single value's phone/email category.
+            for prior in remote.get('custom_fields_values') or []:
+                if prior.get('field_code')==field.upper() and prior.get('values'):
+                    item.update({k:prior['values'][0][k] for k in ('enum_id','enum_code') if k in prior['values'][0]})
+            result.setdefault('custom_fields_values',[]).append({'field_code':field.upper(),'values':[item]})
+        else: raise CRMAccessError('scalar_field_contract_unverified')
+    return result
+
+
+def _finish(cur,event,state,error=''):
+    cur.execute('''UPDATE saas_crm_scalar_outbox SET state=%s,error_code=%s,updated_at=clock_timestamp()
+      WHERE id=%s::uuid''',(state,error,event))
+    return state
+
+
+def dispatch(factory,event_id,request):
+    """request(binding,method,path,json_body=...) must be bound, no-refresh I/O."""
+    with factory() as conn:
+        with conn.cursor() as cur:
+            key='crm-scalar:'+str(event_id)
+            cur.execute('SELECT pg_try_advisory_lock(hashtextextended(%s,0)) AS locked',(key,))
+            if not cur.fetchone()['locked']: return 'busy'
+            conn.commit()
+            try:
+                cur.execute('SELECT tenant_id,actor_id FROM saas_crm_scalar_outbox WHERE id=%s::uuid',(event_id,))
+                admission=cur.fetchone()
+                if not admission: return 'missing'
+                lock_admission(cur,str(admission['tenant_id']),admission['actor_id'])
+                cur.execute('SELECT * FROM saas_crm_scalar_outbox WHERE id=%s::uuid FOR UPDATE',(event_id,))
+                event=cur.fetchone()
+                if not event: return 'missing'
+                if event['state'] not in ('pending','processing'): return event['state']
+                if event['attempt_outcome']=='sending':
+                    return _finish(cur,event_id,'unknown','scalar_outcome_unknown')
+                write_started=False
+                try:
+                    binding=reauthorize(cur,event)
+                    path=('contacts/' if event['entity_type']=='contact' else 'leads/')+event['external_id']
+                    remote=request(binding,'GET',path)
+                    observed=_remote_values(event,remote)
+                    if observed==event['values']:
+                        return _finish(cur,event_id,'synced')
+                    if observed!=event['before_values']:
+                        return _finish(cur,event_id,'conflict','scalar_remote_changed')
+                    payload=body(event,remote)
+                    cur.execute("UPDATE saas_crm_scalar_outbox SET state='processing',attempt_outcome='sending' WHERE id=%s::uuid",(event_id,))
+                    conn.commit()  # Persist the possible-send barrier before any PATCH.
+                    lock_admission(cur,str(event['tenant_id']),event['actor_id'])
+                    cur.execute('SELECT * FROM saas_crm_scalar_outbox WHERE id=%s::uuid FOR UPDATE',(event_id,))
+                    event=cur.fetchone()
+                    binding=reauthorize(cur,event)
+                    # Local authorization, mapping, integration and policy stay
+                    # locked through PATCH and verification. No refresh may write
+                    # those integration rows from another connection while held.
+                    try:
+                        write_started=True
+                        request(binding,'PATCH',path,json_body=payload)
+                        cur.execute("UPDATE saas_crm_scalar_outbox SET attempt_outcome='acknowledged' WHERE id=%s::uuid",(event_id,))
+                        remote=request(binding,'GET',path)
+                        if _remote_values(event,remote)!=event['values']:
+                            return _finish(cur,event_id,'conflict','scalar_readback_conflict')
+                    except Exception:
+                        return _finish(cur,event_id,'unknown','scalar_outcome_unknown')
+                    cur.execute("UPDATE saas_crm_scalar_outbox SET attempt_outcome='acknowledged' WHERE id=%s::uuid",(event_id,))
+                    return _finish(cur,event_id,'synced')
+                except CRMAccessError as error:
+                    if not write_started:
+                        cur.execute("UPDATE saas_crm_scalar_outbox SET attempt_outcome='not_started' WHERE id=%s::uuid",(event_id,))
+                    state=('superseded' if error.code=='scalar_superseded' else
+                           'needs_verification' if error.code in ('scalar_previous_outcome_unknown','scalar_legacy_outcome_unknown') else 'disabled')
+                    return _finish(cur,event_id,state,error.code)
+            finally:
+                try: conn.commit()
+                finally:
+                    conn.rollback()
+                    cur.execute('SELECT pg_advisory_unlock(hashtextextended(%s,0))',(key,))
+                    conn.commit()
+
+
+async def run_batch(factory,bound_request,logger):
+    from tenant_scoped_access import scoped_access_enabled
+    if not scoped_access_enabled() or bound_request is None: return
+    def pending():
+        with factory() as conn:
+            with conn.cursor() as cur:
+                cur.execute("SELECT id FROM saas_crm_scalar_outbox WHERE state IN ('pending','processing') ORDER BY created_at,id LIMIT 5")
+                return [row['id'] for row in cur.fetchall()]
+    loop=asyncio.get_running_loop()
+    def request(binding,*args,**kwargs):
+        # Transport has fixed finite HTTP timeout and no detached/background retry.
+        return asyncio.run_coroutine_threadsafe(bound_request(binding,*args,**kwargs),loop).result()
+    for event in await asyncio.to_thread(pending):
+        try: await asyncio.to_thread(dispatch,factory,event,request)
+        except Exception:
+            logger.warning('Scoped CRM scalar delivery unavailable')
