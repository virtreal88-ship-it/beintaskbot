+    cur.execute('''SELECT 1 FROM saas_crm_scalar_heads WHERE tenant_id=%s::uuid
+      AND entity_type=%s AND internal_id=%s::uuid''',
+      (row['tenant_id'],row['entity_type'],row['internal_id']))
+    return bool(cur.fetchone())
