+/* Isolated DOM integration tests: all fetches mocked; no credentials/provider I/O. */
+const assert=require('node:assert/strict'),fs=require('node:fs'),path=require('node:path');
+const {JSDOM}=require('jsdom');
+const source=name=>fs.readFileSync(path.join(__dirname,'../docs/',name),'utf8');
+const tick=()=>new Promise(resolve=>setTimeout(resolve,10));
+function harness(provider, actions, role='worker', linearSettings={}){
+ const dom=new JSDOM('<div id="view-settings"></div><div id="integrationSettingsHost"></div>',{url:'https://test.invalid',runScripts:'outside-only'}),w=dom.window;
+ const watchers=[], calls=[], confirmations=[];
+ w.tenantViewDemand={watch:item=>watchers.push(item),clean:()=>{}};
+ w.confirm=message=>{confirmations.push(message);return true;};
+ w.TenantLinearRules={render:()=>{},read:()=>({})};
+ w.fetch=async(url,options={})=>{calls.push({url,...options});return {ok:true,json:async()=>({success:true,updated_at:'v2',status:'connected',configured:true,channels:[],members:[],settings:linearSettings,teams:{nodes:[],pageInfo:{}}})};};
+ w.eval(source('tenant-shared-integration-settings.js'));
+ for(const file of ['tenant-kommo-settings.js','tenant-linear-settings.js','tenant-chat-ai-settings.js'])w.eval(source(file));
+ const data={member:{tenant_id:'tenant-a',telegram_id:42,role},integrations:[{provider:provider==='openai'?'chat_ai':provider,status:'connected',updated_at:'v1',...(actions?{management_actions:actions,status_only:!actions.view}:{})}]};
+ watchers.filter(item=>item.provider===provider).forEach(item=>item.activate(data));
+ return {w,calls,confirmations,data,watchers,shared:w.tenantSharedIntegrations,close:()=>dom.window.close()};
+}
+(async()=>{
+ for(const provider of ['kommo','linear','openai','beinsystems','connect']){
+  let h=harness(provider,{view:false,create:false,update:false,delete:false});await tick();
+  assert.equal(h.calls.length,0,provider+' status-only must not fetch private settings');
+  assert.equal(h.w.document.querySelectorAll('input').length,0,provider+' status-only has no credential fields');h.close();
+  h=harness(provider,null);await tick();assert.equal(h.calls.length,0,provider+' legacy worker remains blocked');h.close();
+  h=harness(provider,{view:false,create:false,update:true,delete:true});await tick();
+  assert.equal(h.calls.length,0,provider+' write-only must not fetch settings');
+  assert.ok(h.w.document.querySelector('input[type=password]'),provider+' write grant independent of role');
+  const payload=h.shared.command(h.data,provider,{api_key:'dummy'},'update');
+  assert.equal(payload.expected_tenant_id,'tenant-a');assert.equal(payload.expected_user_id,42);assert.equal(payload.confirm_company_impact,true);
+  assert.equal(h.confirmations.length,1);
+  h.w.confirm=()=>false;assert.throws(()=>h.shared.command(h.data,provider,{},'delete'),/ləğv/);
+  assert.throws(()=>h.shared.command(h.data,provider,{},'create'),/icazə/);
+  h.close();
+ }
+ const reconnectHarness=harness('connect',{view:false,create:false,update:true,delete:false});
+ const reconnectPayload=reconnectHarness.shared.command(reconnectHarness.data,'connect',{action:'reconnect_channel',channel_id:'synthetic'},'update');
+ assert.equal(reconnectPayload.confirm_company_impact,true,'reconnect confirms company-wide webhook changes');
+ assert.equal(reconnectHarness.confirmations.length,1);
+ reconnectHarness.w.confirm=()=>false;
+ assert.throws(()=>reconnectHarness.shared.command(reconnectHarness.data,'connect',{action:'reconnect_channel'},'update'),/ləğv/);
+ reconnectHarness.close();
+ let h=harness('connect',{view:false,create:false,update:false,delete:true});await tick();
+ assert.equal(h.calls.length,0,'delete-only Connect does not read channels or private settings');
+ const channel=h.w.document.querySelector('[data-disconnect-channel]'),disconnect=h.w.document.querySelector('[data-disconnect-by-id]');
+ assert.ok(channel&&disconnect,'delete-only has explicit UUID disconnect control');
+ channel.value='invalid';disconnect.click();await tick();assert.equal(h.calls.length,0,'invalid UUID never submitted');
+ channel.value='11111111-2222-4333-8444-555555555555';h.w.confirm=()=>false;disconnect.click();await tick();
+ assert.equal(h.calls.length,0,'declined company impact never submits');
+ h.w.confirm=message=>{h.confirmations.push(message);return true;};disconnect.click();await tick();
+ assert.equal(h.calls.length,1);assert.equal(h.calls[0].method,'POST');
+ const disconnectBody=JSON.parse(h.calls[0].body);
+ assert.equal(disconnectBody.action,'disconnect_channel');assert.equal(disconnectBody.channel_id,channel.value);
+ assert.equal(disconnectBody.expected_tenant_id,'tenant-a');assert.equal(disconnectBody.expected_user_id,42);
+ assert.equal(disconnectBody.confirm_company_impact,true);assert.equal(h.confirmations.length,1);h.close();
+ h=harness('openai',{view:false,create:false,update:false,delete:true});await tick();
+ const remove=h.w.document.getElementById('tcAiRemove');assert.equal(remove.disabled,false);remove.click();
+ assert.equal(h.w.document.getElementById('tcAiSave').disabled,false,'delete-only can submit removal');
+ h.w.document.getElementById('tcAiSave').click();await tick();
+ const posted=JSON.parse(h.calls.find(call=>call.method==='POST').body);
+ assert.equal(posted.remove_key,true);assert.equal(posted.preserve_settings,true);assert.equal(posted.confirm_company_impact,true);
+ assert.equal('enabled' in posted,false,'key-only deletion must not overwrite unknown company settings');h.close();
+ h=harness('linear',{view:true,create:false,update:false,delete:false});await tick();
+ assert.equal(h.calls.some(call=>call.url==='/api/platform/members'),false,'integration view does not require employee-management access');
+ assert.equal(h.w.document.getElementById('tlConnect').disabled,true);assert.equal(h.w.document.getElementById('tlDisconnect').disabled,true);h.close();
+ const retained={team_id:'',done_state_ids:[],members:{'7':{account:'Account',can_create:true,button_ids:['ready']}},news:{enabled:true,channel:'saved-channel',projects:['p1']},workflow:{enabled:true,buttons:[{id:'ready',label:'Ready'}],sync_enabled:true}};
+ h=harness('linear',{view:true,create:false,update:true,delete:false},'worker',retained);await tick();
+ const ownerSettings=h.w.document.querySelector('[data-tl-owner-settings]');
+ assert.equal(ownerSettings.hidden,true,'scoped nonowner cannot edit members, news or workflow');
+ for(const input of ownerSettings.querySelectorAll('input,button,select'))assert.equal(input.disabled,true);
+ assert.equal(h.w.document.getElementById('tlTeam').disabled,false,'team control remains editable');
+ h.w.TenantLinearRules.read=()=>{throw new Error('must not read protected workflow from DOM');};
+ h.w.document.getElementById('tlNewsEnabled').checked=false;h.w.document.getElementById('tlChannel').value='tampered';
+ h.w.document.getElementById('tlStates').innerHTML='<input type="checkbox" checked value="done-new">';
+ h.w.document.getElementById('tlSave').click();await tick();
+ const settingsWrite=h.calls.find(call=>call.method==='POST');assert.ok(settingsWrite);
+ const saved=JSON.parse(settingsWrite.body).settings;
+ assert.deepEqual(saved.members,retained.members,'hidden member bindings retained');
+ assert.deepEqual(saved.news,retained.news,'hidden news retained despite DOM changes');
+ assert.deepEqual(saved.workflow,retained.workflow,'workflow retained without reading hidden editor');
+ assert.deepEqual(saved.done_state_ids,['done-new'],'permitted done states remain editable');h.close();
+ console.log('PASS shared integration DOM: five providers, legacy fallback, safe status, independent grants, confirmations and bound writes');
+})().catch(error=>{console.error(error);process.exitCode=1;});
