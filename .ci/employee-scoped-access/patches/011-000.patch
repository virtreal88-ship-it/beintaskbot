index 0000000000000000000000000000000000000000..5ff4c1418a4ae705245513ebf489fbb64e68bf05
--- /dev/null
+++ b/beintaskbot-main/tenant_crm_relation_contract.py
@@ -0,0 +1,251 @@
+"""Inactive, provider-neutral contract for future relation-only synchronization.
+
+Nothing imports this module from a route, queue, migration or provider worker.
+It performs no I/O and grants no permission to send. In particular, a local FK
+change does not determine the provider's desired relation set. An independently
+approved adapter must supply that interpretation and complete state digests.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import datetime, timezone
+import hashlib
+import json
+import re
+import uuid
+
+
+class RelationContractError(ValueError):
+    """Static errors only: never echo provider payloads or customer data."""
+
+
+def _uuid(value):
+    if not isinstance(value, str):
+        raise RelationContractError('invalid_record_identity')
+    try:
+        return str(uuid.UUID(value))
+    except ValueError:
+        raise RelationContractError('invalid_record_identity') from None
+
+
+def _text(value):
+    if (not isinstance(value, str) or not 1 <= len(value) <= 240
+            or value != value.strip() or any(ord(c) < 32 or ord(c) == 127 for c in value)):
+        raise RelationContractError('invalid_binding_identifier')
+    return value
+
+
+def _digest(value):
+    if not isinstance(value, str) or not re.fullmatch(r'[0-9a-f]{64}', value):
+        raise RelationContractError('invalid_relation_digest')
+    return value
+
+
+def _object(value, keys):
+    if not isinstance(value, dict) or set(value) != set(keys):
+        raise RelationContractError('invalid_relation_payload')
+    return value
+
+
+@dataclass(frozen=True)
+class RecordRef:
+    entity_type: str
+    internal_id: str
+
+    def __post_init__(self):
+        if self.entity_type not in ('contact', 'deal', 'company'):
+            raise RelationContractError('invalid_relation_entity')
+        object.__setattr__(self, 'internal_id', _uuid(self.internal_id))
+
+
+@dataclass(frozen=True)
+class ProviderBinding:
+    tenant_id: str
+    provider: str
+    account_id: str
+    connection_generation: str
+
+    def __post_init__(self):
+        object.__setattr__(self, 'tenant_id', _uuid(self.tenant_id))
+        if self.provider not in ('kommo', 'beinsystems'):
+            raise RelationContractError('invalid_relation_provider')
+        _text(self.account_id)
+        _text(self.connection_generation)
+
+
+@dataclass(frozen=True)
+class BoundIdentity:
+    record: RecordRef
+    external_id: str
+    binding: ProviderBinding
+
+    def __post_init__(self):
+        if not isinstance(self.record, RecordRef) or not isinstance(self.binding, ProviderBinding):
+            raise RelationContractError('invalid_bound_identity')
+        _text(self.external_id)
+
+
+@dataclass(frozen=True)
+class ProviderExpectation:
+    """Adapter-owned full relation state, not hashes of the single local FK.
+
+    The version identifies approved normalization and operation semantics.
+    Digests must cover the complete relevant relation set and provider metadata
+    (e.g. all Kommo contacts and main-contact flags), including empty states.
+    This module cannot establish that an adapter has such an approved contract.
+    """
+    contract_version: str
+    expected_digest: str
+    desired_digest: str
+
+    def __post_init__(self):
+        _text(self.contract_version)
+        _digest(self.expected_digest)
+        _digest(self.desired_digest)
+
+
+# These describe already implemented local FK changes, not provider support or
+# new authorization. Company -> deal and create-time selection are not implied.
+_RELATIONS = {'deal_contact': ('deal', 'contact'), 'contact_company': ('contact', 'company')}
+
+
+@dataclass(frozen=True)
+class RelationIntent:
+    event_id: str
+    actor_id: int
+    source: RecordRef
+    relation: str
+    changed: BoundIdentity
+    before: BoundIdentity | None
+    after: BoundIdentity | None
+    local_revision: datetime
+    provider_expectation: ProviderExpectation | None = None
+
+    def __post_init__(self):
+        object.__setattr__(self, 'event_id', _uuid(self.event_id))
+        if type(self.actor_id) is not int or self.actor_id <= 0:
+            raise RelationContractError('human_actor_required')
+        if not isinstance(self.source, RecordRef) or not isinstance(self.changed, BoundIdentity):
+            raise RelationContractError('invalid_relation_source')
+        if not isinstance(self.relation, str) or self.relation not in _RELATIONS:
+            raise RelationContractError('invalid_local_relation')
+        changed_type, target_type = _RELATIONS[self.relation]
+        if self.changed.record.entity_type != changed_type:
+            raise RelationContractError('invalid_changed_entity')
+        targets = []
+        for target in (self.before, self.after):
+            if target is None:
+                continue
+            if not isinstance(target, BoundIdentity) or target.record.entity_type != target_type:
+                raise RelationContractError('invalid_relation_target')
+            if target.binding != self.changed.binding:
+                raise RelationContractError('relation_binding_mismatch')
+            targets.append(target)
+        if (self.before.record if self.before else None) == (self.after.record if self.after else None):
+            raise RelationContractError('no_local_relation_change')
+        if len(targets) == 2 and targets[0].external_id == targets[1].external_id:
+            raise RelationContractError('external_identity_collision')
+        if self.source not in [self.changed.record, *(target.record for target in targets)]:
+            raise RelationContractError('source_not_in_relation')
+        # Reverse-card linking can assign only that source; reverse-card
+        # unlinking can clear only that exact source, never another relation.
+        if self.source != self.changed.record:
+            target = self.after if self.after is not None else self.before
+            if target.record != self.source:
+                raise RelationContractError('source_action_mismatch')
+        if (not isinstance(self.local_revision, datetime)
+                or self.local_revision.tzinfo is None or self.local_revision.utcoffset() is None):
+            raise RelationContractError('timezone_aware_revision_required')
+        object.__setattr__(self, 'local_revision', self.local_revision.astimezone(timezone.utc))
+        if self.provider_expectation is not None and not isinstance(self.provider_expectation, ProviderExpectation):
+            raise RelationContractError('invalid_provider_expectation')
+
+    def to_payload(self):
+        def record(ref):
+            return {'entity_type': ref.entity_type, 'internal_id': ref.internal_id}
+        def identity(ref):
+            return None if ref is None else {**record(ref.record), 'external_id': ref.external_id}
+        binding, expectation = self.changed.binding, self.provider_expectation
+        return {'version': 1, 'event_id': self.event_id, 'actor_id': self.actor_id,
+                'source': record(self.source), 'source_action': 'update',
+                'binding': {'tenant_id': binding.tenant_id, 'provider': binding.provider,
+                            'account_id': binding.account_id,
+                            'connection_generation': binding.connection_generation},
+                'relation': self.relation, 'changed': identity(self.changed),
+                'before': identity(self.before), 'after': identity(self.after),
+                'local_revision': self.local_revision.isoformat(),
+                'provider_expectation': None if expectation is None else {
+                    'contract_version': expectation.contract_version,
+                    'expected_digest': expectation.expected_digest,
+                    'desired_digest': expectation.desired_digest}}
+
+    @classmethod
+    def from_payload(cls, value):
+        data = _object(value, ('version', 'event_id', 'actor_id', 'source', 'source_action',
+                              'binding', 'relation', 'changed', 'before', 'after',
+                              'local_revision', 'provider_expectation'))
+        if type(data['version']) is not int or data['version'] != 1 or data['source_action'] != 'update':
+            raise RelationContractError('unsupported_relation_contract')
+        binding = ProviderBinding(**_object(data['binding'],
+            ('tenant_id', 'provider', 'account_id', 'connection_generation')))
+        source = RecordRef(**_object(data['source'], ('entity_type', 'internal_id')))
+        def identity(value):
+            if value is None:
+                return None
+            row = _object(value, ('entity_type', 'internal_id', 'external_id'))
+            return BoundIdentity(RecordRef(row['entity_type'], row['internal_id']), row['external_id'], binding)
+        if not isinstance(data['local_revision'], str):
+            raise RelationContractError('invalid_local_revision')
+        try:
+            revision = datetime.fromisoformat(data['local_revision'])
+        except ValueError:
+            raise RelationContractError('invalid_local_revision') from None
+        expectation = data['provider_expectation']
+        if expectation is not None:
+            expectation = ProviderExpectation(**_object(expectation,
+                ('contract_version', 'expected_digest', 'desired_digest')))
+        return cls(data['event_id'], data['actor_id'], source, data['relation'], identity(data['changed']),
+                   identity(data['before']), identity(data['after']), revision, expectation)
+
+    def fingerprint(self):
+        """Content identity for collision checks, NOT provider idempotency."""
+        encoded = json.dumps(self.to_payload(), sort_keys=True, separators=(',', ':'), ensure_ascii=True)
+        return hashlib.sha256(encoded.encode('utf-8')).hexdigest()
+
+
+def classify_observation(intent, *, event_fingerprint, binding, contract_version,
+                         observed_digest, attempt_outcome):
+    """Classify read-back evidence, never authorize a write or automatic retry.
+
+    'expected_observed' is not send-ready: current source-card U, tenant and
+    membership, policy, mappings, local revision and a provider concurrency
+    strategy still need transactional revalidation. Even a desired observation
+    does not prove that this event caused it or settle an in-flight request.
+    """
+    if not isinstance(intent, RelationIntent) or not isinstance(binding, ProviderBinding):
+        raise RelationContractError('invalid_observation_binding')
+    if attempt_outcome not in ('not_started', 'definitely_not_sent', 'unknown', 'acknowledged'):
+        raise RelationContractError('invalid_attempt_outcome')
+    _digest(event_fingerprint)
+    if observed_digest is not None:
+        _digest(observed_digest)
+    if event_fingerprint != intent.fingerprint():
+        return 'event_changed'
+    if binding != intent.changed.binding:
+        return 'connection_changed'
+    expectation = intent.provider_expectation
+    if expectation is None:
+        return 'provider_contract_missing'
+    if contract_version != expectation.contract_version:
+        return 'provider_contract_changed'
+    if observed_digest is None:
+        return 'observation_unknown'
+    if observed_digest == expectation.desired_digest:
+        return 'desired_observed'
+    if observed_digest != expectation.expected_digest:
+        return 'relation_conflict'
+    # An expired lease or a timeout is not proof the request was never sent.
+    # An unchanged read may race the first request; never infer safe replay.
+    if attempt_outcome in ('unknown', 'acknowledged'):
+        return 'outcome_unknown'
+    return 'expected_observed'
diff --git a/beintaskbot-main/tenant_crm_relation_delivery.py b/beintaskbot-main/tenant_crm_relation_delivery.py
new file mode 100644
index 0000000000000000000000000000000000000000..256f43fd4920aba2a0c6e2681675c2a8f1532524
--- /dev/null
+++ b/beintaskbot-main/tenant_crm_relation_delivery.py
@@ -0,0 +1,116 @@
+"""Dormant, crash-conservative driver. No production transport is registered.
+
+An adapter MUST atomically compare the complete remote relation state and apply
+one narrow request. Kommo's public link/unlink endpoints do not establish that
+contract. A read/check/POST implementation is NOT a valid adapter. Tests supply
+an in-memory conditional adapter only. BEIN has no relation adapter at all.
+"""
+import json
+from tenant_crm_native_access import CRMAccessError
+from tenant_crm_relation_contract import RelationContractError
+from tenant_crm_relation_store import reauthorize
+from tenant_crm_relation_kommo import CONTRACT_VERSION, RelationConflict, canonical, digest, plan
+
+
+def _row(cur, event):
+    cur.execute('SELECT * FROM saas_crm_relation_outbox WHERE id=%s::uuid FOR UPDATE', (event,))
+    return cur.fetchone()
+
+
+def _finish(cur, event, state, error='', observation=None):
+    cur.execute('''UPDATE saas_crm_relation_outbox SET state=%s,error_code=%s,
+      observation=%s::jsonb,updated_at=clock_timestamp() WHERE id=%s::uuid''',
+      (state, error, json.dumps(observation) if observation is not None else None, event))
+    return state
+
+
+def drive(factory, event, *, adapter=None):
+    """Process at most one step. No automatic retry or compensation.
+
+    A session lock spans commits, while sending is committed BEFORE provider
+    I/O. After a crash/timeout, sending is terminal unknown, even when a later
+    GET shows the desired state: the earlier request may still be in flight.
+    Connections MUST be dedicated, not pooled without resetting session locks.
+    No caller exists in the app. adapter=None always fails closed without I/O.
+    """
+    with factory() as conn:
+        with conn.cursor() as cur:
+            cur.execute('SELECT pg_try_advisory_lock(hashtextextended(%s,0)) AS locked',
+                        ('crm-relation:' + str(event),))
+            if not cur.fetchone()['locked']:
+                return 'busy'
+            conn.commit()
+            try:
+                row = _row(cur, event)
+                if not row:
+                    return 'missing'
+                if row['state'] not in ('pending', 'processing', 'unknown'):
+                    return row['state']
+                if row['attempt_outcome'] == 'sending' or row['state'] == 'unknown':
+                    return _finish(cur, event, 'unknown', 'relation_outcome_unknown')
+                if adapter is None:
+                    return _finish(cur, event, 'disabled', 'relation_conditional_adapter_unavailable')
+                try:
+                    intent = reauthorize(cur, row)
+                    if intent.changed.binding.provider != 'kommo':
+                        raise RelationConflict('relation_provider_unsupported')
+                    expectation = intent.provider_expectation
+                    if expectation is None or expectation.contract_version != CONTRACT_VERSION:
+                        raise RelationConflict('relation_contract_missing')
+                    # Adapter binds reads and writes to the exact connection generation.
+                    observed = canonical(adapter.observe(intent.changed.binding, intent.relation,
+                        intent.changed.external_id), intent.relation)
+                    initial = row['plan']['initial'] if row['plan'] else observed
+                    prepared = plan(intent.relation, intent.changed.external_id,
+                        intent.before.external_id if intent.before else None,
+                        intent.after.external_id if intent.after else None, initial)
+                    if (digest(prepared.states[0], intent.relation) != expectation.expected_digest
+                            or digest(prepared.states[-1], intent.relation) != expectation.desired_digest):
+                        raise RelationConflict('relation_expectation_mismatch')
+                    index = row['step_index']
+                    if index > len(prepared.steps) or observed != prepared.states[index]:
+                        raise RelationConflict('relation_remote_conflict')
+                    if index == len(prepared.steps):
+                        return _finish(cur, event, 'synced', observation=observed)
+                    cur.execute('''UPDATE saas_crm_relation_outbox SET plan=%s::jsonb,
+                      state='processing',attempt_outcome='sending',updated_at=clock_timestamp()
+                      WHERE id=%s::uuid''', (json.dumps({'initial': initial}), event))
+                    conn.commit()  # Durable no-replay barrier. No I/O precedes it.
+                    row = _row(cur, event)
+                    intent = reauthorize(cur, row)
+                    # Keep authorization, resource, mapping, connection and sync policy
+                    # row locks held throughout conditional I/O and the result commit.
+                    try:
+                        result = adapter.compare_and_apply(intent.changed.binding, intent.relation,
+                            prepared.states[index], prepared.request(index))
+                    except Exception:
+                        return _finish(cur, event, 'unknown', 'relation_outcome_unknown')
+                    if result == 'conflict':
+                        return _finish(cur, event, 'conflict', 'relation_remote_conflict')
+                    if result != 'applied':
+                        return _finish(cur, event, 'unknown', 'relation_outcome_unknown')
+                    try:
+                        observed = canonical(adapter.observe(intent.changed.binding, intent.relation,
+                            intent.changed.external_id), intent.relation)
+                    except Exception:
+                        return _finish(cur, event, 'unknown', 'relation_readback_unknown')
+                    if observed != prepared.states[index + 1]:
+                        return _finish(cur, event, 'conflict', 'relation_readback_conflict', observed)
+                    cur.execute('''UPDATE saas_crm_relation_outbox SET step_index=step_index+1,
+                      attempt_outcome='acknowledged' WHERE id=%s::uuid''', (event,))
+                    return _finish(cur, event, 'synced' if index + 1 == len(prepared.steps) else 'pending',
+                                   observation=observed)
+                except CRMAccessError as error:
+                    state = 'superseded' if error.code == 'relation_superseded' else 'disabled'
+                    return _finish(cur, event, state, error.code)
+                except (RelationConflict, RelationContractError):
+                    return _finish(cur, event, 'conflict', 'relation_validation_conflict')
+            finally:
+                # A failed commit leaves the prior durable sending marker in place.
+                try:
+                    conn.commit()
+                finally:
+                    conn.rollback()
+                    cur.execute('SELECT pg_advisory_unlock(hashtextextended(%s,0))',
+                                ('crm-relation:' + str(event),))
+                    conn.commit()
diff --git a/beintaskbot-main/tenant_crm_relation_identity.py b/beintaskbot-main/tenant_crm_relation_identity.py
new file mode 100644
index 0000000000000000000000000000000000000000..642a6c98afdb547d351ddd2fd31e0c84b550d659
--- /dev/null
+++ b/beintaskbot-main/tenant_crm_relation_identity.py
@@ -0,0 +1,96 @@
+"""Explicit account/generation mappings. Never infer them from legacy IDs."""
+from datetime import datetime, timezone
+import re
+
+from tenant_crm_relation_contract import BoundIdentity, ProviderBinding, RecordRef
+from tenant_crm_native_access import CRMAccessError
+
+
+def connection_binding(tenant, row):
+    if (not row or row.get('status') != 'connected'
+            or row.get('provider') not in ('kommo', 'kommo_manual')
+            or not row.get('account_domain') or not row.get('connected_at')):
+        return None
+    stamp = row['connected_at']
+    if not re.fullmatch(r'[a-z0-9][a-z0-9.-]*', row['account_domain']):
+        return None
+    if isinstance(stamp, str):
+        try:
+            stamp = datetime.fromisoformat(stamp.replace('Z', '+00:00'))
+        except ValueError:
+            return None
+    if not isinstance(stamp, datetime) or stamp.tzinfo is None:
+        return None
+    generation = row['provider'] + ':' + stamp.astimezone(timezone.utc).isoformat()
+    return ProviderBinding(str(tenant), 'kommo', row['account_domain'], generation)
+
+
+def current_binding(cur, tenant, *, lock=True):
+    if lock:
+        # Also fence a concurrent INSERT of the preferred OAuth integration.
+        cur.execute('SELECT id FROM saas_tenants WHERE id=%s::uuid FOR UPDATE', (tenant,))
+        if not cur.fetchone():
+            return None
+    cur.execute('''SELECT provider,status,account_domain,connected_at FROM saas_tenant_integrations
+      WHERE tenant_id=%s::uuid AND provider IN ('kommo','kommo_manual')
+      ORDER BY provider''' + (' FOR SHARE' if lock else ''), (tenant,))
+    rows = {row['provider']: row for row in cur.fetchall()}
+    selected = next((rows[p] for p in ('kommo', 'kommo_manual')
+                     if rows.get(p, {}).get('status') == 'connected'), None)
+    return connection_binding(tenant, selected)
+
+
+def _args(binding):
+    return (binding.tenant_id, binding.provider, binding.account_id, binding.connection_generation)
+
+
+def bind_identity(cur, identity, *, provenance, evidence_id, verified_by=None):
+    """Trusted store primitive, not a browser operation or automatic backfill.
+
+    created/imported callers must have proved this NEW mapping's connection
+    throughout the source operation. owner_verified requires an exact owner
+    assertion, not merely GETting a coincidentally equal ID in a new account.
+    """
+    if not isinstance(identity, BoundIdentity) or identity.binding.provider != 'kommo':
+        raise ValueError('invalid_relation_identity')
+    if provenance not in ('created', 'imported', 'owner_verified') or not isinstance(evidence_id, str) or not evidence_id.strip():
+        raise ValueError('relation_identity_evidence_required')
+    if provenance == 'owner_verified' and (type(verified_by) is not int or verified_by <= 0):
+        raise ValueError('relation_identity_owner_required')
+    if not re.fullmatch(r'[1-9][0-9]{0,18}', identity.external_id):
+        raise ValueError('invalid_kommo_identity')
+    if current_binding(cur, identity.binding.tenant_id) != identity.binding:
+        raise CRMAccessError('relation_connection_changed', 409)
+    from tenant_crm_relation_store import ENTITIES
+    table = ENTITIES[identity.record.entity_type][1]
+    cur.execute(f'''SELECT id FROM {table} WHERE tenant_id=%s::uuid
+      AND id=%s::uuid AND archived_at IS NULL FOR SHARE''',
+      (identity.binding.tenant_id, identity.record.internal_id))
+    if not cur.fetchone():
+        raise CRMAccessError('relation_resource_unavailable')
+    if provenance == 'owner_verified':
+        from tenant_scoped_access_store import read_access_profile
+        profile = read_access_profile(cur, identity.binding.tenant_id, verified_by, lock=True)
+        if not profile or profile.get('role') != 'owner':
+            raise CRMAccessError('relation_identity_owner_required')
+    cur.execute('''INSERT INTO saas_crm_relation_identities
+      (tenant_id,provider,account_id,connection_generation,entity_type,internal_id,external_id,
+       provenance,evidence_id,verified_by) VALUES(%s::uuid,%s,%s,%s,%s,%s::uuid,%s,%s,%s,%s)
+      ON CONFLICT(tenant_id,provider,account_id,connection_generation,entity_type,internal_id)
+      DO UPDATE SET evidence_id=saas_crm_relation_identities.evidence_id
+      WHERE saas_crm_relation_identities.external_id=EXCLUDED.external_id RETURNING external_id''',
+      (*_args(identity.binding), identity.record.entity_type, identity.record.internal_id,
+       identity.external_id, provenance, evidence_id[:240], verified_by))
+    if not cur.fetchone():
+        raise CRMAccessError('relation_identity_conflict', 409)
+
+
+def read_identity(cur, binding, record):
+    cur.execute('''SELECT external_id FROM saas_crm_relation_identities WHERE tenant_id=%s::uuid
+      AND provider=%s AND account_id=%s AND connection_generation=%s
+      AND entity_type=%s AND internal_id=%s::uuid FOR SHARE''',
+      (*_args(binding), record.entity_type, record.internal_id))
+    row = cur.fetchone()
+    if not row:
+        raise CRMAccessError('relation_mapping_unverified', 409)
+    return BoundIdentity(record, row['external_id'], binding)
diff --git a/beintaskbot-main/tenant_crm_relation_kommo.py b/beintaskbot-main/tenant_crm_relation_kommo.py
new file mode 100644
index 0000000000000000000000000000000000000000..304574dcff2984df3dbff9694c9efc7d6e792627
--- /dev/null
+++ b/beintaskbot-main/tenant_crm_relation_kommo.py
@@ -0,0 +1,156 @@
+"""Relation-only Kommo planning. Never PATCH or rebuild a full CRM record.
+
+Request metadata uses is_main (official PHP SDK ContactModel.getMetadataForLink),
+whereas GET /links returns metadata.main_contact. All other contacts are retained.
+"""
+from dataclasses import dataclass
+import re
+import hashlib
+import json
+
+
+CONTRACT_VERSION = 'kommo-main-contact-v1'
+
+
+class RelationConflict(ValueError):
+    pass
+
+
+def external_id(value):
+    if type(value) is int:
+        value = str(value)
+    if not isinstance(value, str) or not re.fullmatch(r'[1-9][0-9]{0,18}', value):
+        raise RelationConflict('invalid_kommo_relation_id')
+    return value
+
+
+def snapshot(payload, relation, changed_id):
+    """Full relevant relation graph. Absent/malformed data never means empty."""
+    changed_id = external_id(changed_id)
+    if relation not in ('deal_contact', 'contact_company'):
+        raise RelationConflict('invalid_relation_snapshot')
+    if (not isinstance(payload, dict) or not isinstance(payload.get('_links', {}), dict)
+            or payload.get('_links', {}).get('next')):
+        raise RelationConflict('incomplete_remote_relation')
+    embedded = payload.get('_embedded')
+    rows = embedded.get('links') if isinstance(embedded, dict) else None
+    if not isinstance(rows, list) or any(not isinstance(row, dict) for row in rows):
+        raise RelationConflict('invalid_remote_relation')
+    if '_total_items' in payload and (type(payload['_total_items']) is not int or payload['_total_items'] != len(rows)):
+        raise RelationConflict('incomplete_remote_relation')
+    target_type = 'contacts' if relation == 'deal_contact' else 'companies'
+    expected_source = 'leads' if relation == 'deal_contact' else 'contacts'
+    result = {}
+    for row in rows:
+        if row.get('entity_id') is not None and external_id(row['entity_id']) != changed_id:
+            raise RelationConflict('remote_relation_source_mismatch')
+        if row.get('entity_type') is not None and row['entity_type'] != expected_source:
+            raise RelationConflict('remote_relation_source_mismatch')
+        if row.get('to_entity_type') != target_type:
+            continue
+        ident = external_id(row.get('to_entity_id'))
+        if ident in result:
+            raise RelationConflict('duplicate_remote_relation')
+        if relation == 'deal_contact':
+            meta = row.get('metadata')
+            main = meta.get('main_contact') if isinstance(meta, dict) else None
+            if type(main) is not bool:
+                raise RelationConflict('remote_main_contact_unknown')
+            result[ident] = main
+        else:
+            result[ident] = False
+    return canonical(result, relation)
+
+
+def canonical(value, relation):
+    if relation not in ('deal_contact', 'contact_company') or not isinstance(value, dict):
+        raise RelationConflict('invalid_relation_snapshot')
+    result = {}
+    for key, main in value.items():
+        ident = external_id(key)
+        if type(main) is not bool:
+            raise RelationConflict('invalid_relation_snapshot')
+        result[ident] = main
+    if sum(result.values()) > 1 or (relation == 'contact_company' and (len(result) > 1 or any(result.values()))):
+        raise RelationConflict('ambiguous_remote_relation')
+    return dict(sorted(result.items(), key=lambda item: int(item[0])))
+
+
+@dataclass(frozen=True)
+class Step:
+    operation: str
+    target_id: str
+    main: bool = False
+
+
+@dataclass(frozen=True)
+class Plan:
+    relation: str
+    changed_id: str
+    states: tuple
+    steps: tuple
+
+    def read_path(self):
+        entity = 'leads' if self.relation == 'deal_contact' else 'contacts'
+        return f'{entity}/{self.changed_id}/links'
+
+    def request(self, index):
+        step = self.steps[index]
+        path = self.read_path().removesuffix('links') + step.operation
+        body = {'to_entity_id': int(step.target_id),
+                'to_entity_type': 'contacts' if self.relation == 'deal_contact' else 'companies'}
+        if step.main:
+            body['metadata'] = {'is_main': True}
+        return 'POST', path, [body]
+
+
+def plan(relation, changed_id, before, after, initial):
+    """Replace/remove ONLY the old main contact; do not remove other contacts.
+
+    No documented CAS exists. The worker compares full snapshots before/after
+    every single step and stops on concurrent differences instead of rewriting
+    a graph or attempting a compensating delete.
+    """
+    changed_id = external_id(changed_id)
+    before = external_id(before) if before is not None else None
+    after = external_id(after) if after is not None else None
+    current = canonical(initial, relation)
+    states, steps = [current], []
+    selected = next((key for key, main in current.items() if main), None) if relation == 'deal_contact' else next(iter(current), None)
+    if selected == after and (before is None or before == after or before not in current):
+        return Plan(relation, changed_id, tuple(states), ())
+    if selected != before:
+        raise RelationConflict('remote_relation_changed')
+
+    def add(operation, target, main=False):
+        nonlocal current
+        current = dict(current)
+        if operation == 'unlink':
+            current.pop(target)
+        else:
+            if main:
+                current = {key: False for key in current}
+            current[target] = main
+        current = canonical(current, relation)
+        steps.append(Step(operation, target, main))
+        states.append(current)
+
+    if relation == 'deal_contact':
+        # Establish the intended main contact before detaching the old one.
+        if after is not None:
+            add('link', after, True)
+        if before is not None and before != after:
+            add('unlink', before)
+    else:
+        # Contact -> company has single-company cardinality; never pretend
+        # its two endpoint operations are atomic.
+        if before is not None and before != after:
+            add('unlink', before)
+        if after is not None:
+            add('link', after)
+    return Plan(relation, changed_id, tuple(states), tuple(steps))
+
+
+def digest(state, relation):
+    encoded = json.dumps(canonical(state, relation), sort_keys=True, separators=(',', ':'))
+    return hashlib.sha256(encoded.encode()).hexdigest()
diff --git a/beintaskbot-main/tenant_crm_relation_schema.py b/beintaskbot-main/tenant_crm_relation_schema.py
new file mode 100644
index 0000000000000000000000000000000000000000..01735c94dbee2d679e2733fb9e6a376f07dbea16
--- /dev/null
+++ b/beintaskbot-main/tenant_crm_relation_schema.py
@@ -0,0 +1,39 @@
+"""Additive, separate journal for narrow CRM relationship delivery."""
+
+
+def migrate_relation_schema(cur):
+    cur.execute('''CREATE TABLE IF NOT EXISTS saas_crm_relation_identities (
+      tenant_id UUID NOT NULL REFERENCES saas_tenants(id) ON DELETE CASCADE,
+      provider TEXT NOT NULL CHECK(provider='kommo'), account_id TEXT NOT NULL,
+      connection_generation TEXT NOT NULL, entity_type TEXT NOT NULL
+        CHECK(entity_type IN ('deal','contact','company')), internal_id UUID NOT NULL,
+      external_id TEXT NOT NULL CHECK(external_id ~ '^[1-9][0-9]*$'),
+      provenance TEXT NOT NULL CHECK(provenance IN ('created','imported','owner_verified')),
+      evidence_id TEXT NOT NULL CHECK(evidence_id<>''), verified_by BIGINT NULL,
+      created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
+      PRIMARY KEY(tenant_id,provider,account_id,connection_generation,entity_type,internal_id),
+      UNIQUE(tenant_id,provider,account_id,connection_generation,entity_type,external_id))''')
+    cur.execute('''CREATE TABLE IF NOT EXISTS saas_crm_relation_outbox (
+      id UUID PRIMARY KEY, tenant_id UUID NOT NULL REFERENCES saas_tenants(id) ON DELETE CASCADE,
+      changed_type TEXT NOT NULL CHECK(changed_type IN ('deal','contact')),
+      changed_id UUID NOT NULL, relation TEXT NOT NULL
+        CHECK(relation IN ('deal_contact','contact_company')),
+      intent JSONB NOT NULL CHECK(jsonb_typeof(intent)='object'),
+      intent_hash TEXT NOT NULL, remote_before TEXT NULL,
+      state TEXT NOT NULL DEFAULT 'pending' CHECK(state IN
+        ('pending','processing','synced','superseded','disabled','conflict','unknown')),
+      plan JSONB NULL, step_index INTEGER NOT NULL DEFAULT 0 CHECK(step_index>=0),
+      attempt_outcome TEXT NOT NULL DEFAULT 'not_started' CHECK(attempt_outcome IN
+        ('not_started','sending','acknowledged')),
+      error_code TEXT NOT NULL DEFAULT '', observation JSONB NULL,
