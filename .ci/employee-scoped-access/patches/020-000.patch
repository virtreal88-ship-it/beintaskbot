+        with pytest.raises(TenantLinearError) as denied:
+            groups.register_employee(person, data)
+        assert denied.value.status == 403
+        assert not db.execute('SELECT * FROM saas_ai_group_staff WHERE tenant_id=%s::uuid', (A,))
