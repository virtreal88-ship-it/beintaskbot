+@pytest.mark.parametrize('scope,channel,allowed', [('none', CA, False), ('department', CA, True), ('department', C2, False), ('all', C2, True)])
+def test_staff_identity_mutation_is_source_and_action_scoped(admin, scope, channel, allowed):
+    db, person = admin
