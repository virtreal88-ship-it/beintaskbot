+    monkeypatch.setattr(assignment, '_connect', lambda: db)
+    db.execute("UPDATE saas_tenant_members SET role='admin' WHERE tenant_id=%s::uuid AND telegram_id=33", (A,))
+    rights(db, 'department', 'none')
